<%# ICS 202 PDF — renders the same .ics-form-sheet as the on-screen
    template, with section flex-grow ratios from the on-screen resize
    state (passed via URL params) so print matches what the user sees.
    The sheet CSS already has print rules (see plans.css.scss) — no
    PDF-specific overrides needed here. %>
<div class="ics-form-sheet ics-202-sheet ics-202-print">

  <div class="sheet-section sheet-title">
    INCIDENT OBJECTIVES (ICS 202)
  </div>

  <div class="sheet-section sheet-header">
    <div class="sheet-header-left">
      <div class="sheet-header-label gray-row strong">1. Incident Name:</div>
      <div class="sheet-header-value"><%= @incident.name %></div>
    </div>
    <div class="sheet-header-right">
      <div class="sheet-header-op gray-row">
        <span class="sheet-header-op-label strong">2. Operational Period:</span>
        <strong class="sheet-header-op-value"><%= @plan.shift.presence || 'DAY' %></strong>
      </div>
      <div class="sheet-header-dates">
        <div class="sheet-header-date">
          <div class="sheet-header-label">Date/Time From:</div>
          <div class="sheet-header-value"><%= @plan.ops_period_from&.strftime('%m/%d/%Y %H:%M') %></div>
        </div>
        <div class="sheet-header-date">
          <div class="sheet-header-label">Date/Time To:</div>
          <div class="sheet-header-value"><%= @plan.ops_period_to&.strftime('%m/%d/%Y %H:%M') %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="sheet-section sheet-text sheet-objectives"
       style="flex-grow: <%= @section_ratios[:objectives] %>;">
    <div class="sheet-text-label">3. Objective(s):</div>
    <div class="sheet-text-body"><%= simple_format(@plan.objectives_text) %></div>
  </div>

  <div class="sheet-divider"></div>

  <div class="sheet-section sheet-text sheet-emphasis"
       style="flex-grow: <%= @section_ratios[:emphasis] %>;">
    <div class="sheet-text-label">4. Operational Period Command Emphasis:</div>
    <div class="sheet-text-body"><%= simple_format(@plan.weather) %></div>
  </div>

  <div class="sheet-divider"></div>

  <div class="sheet-section sheet-text sheet-awareness"
       style="flex-grow: <%= @section_ratios[:awareness] %>;">
    <div class="sheet-text-label">General Situational Awareness:</div>
    <div class="sheet-text-body"><%= simple_format(@plan.general_safety) %></div>
  </div>

  <div class="sheet-section sheet-section-5">
    <span class="sheet-text-label sheet-inline-label sheet-normal strong">5. Site Safety Plan Required?</span>
    <span class="ssp-toggle-group">
      <label class="ssp-check">
        <span class="ssp-check-label">Yes</span>
        <span class="ssp-check-box"><%= @plan.site_safety_plan_required == 'Yes' ? '☑' : '☐' %></span>
      </label>
      <label class="ssp-check">
        <span class="ssp-check-label">No</span>
        <span class="ssp-check-box"><%= @plan.site_safety_plan_required == 'No' ? '☑' : '☐' %></span>
      </label>
    </span>
    <span class="ssp-location">
      <span>Approved Site Safety Plan(s) Located at:</span>
      <span><%= @plan.site_safety_plan_location %></span>
    </span>
  </div>

  <div class="sheet-section sheet-section-6">
    <div class="sheet-text-label strong">6. Incident Action Plan
      <span class="sheet-normal">(the items checked below are included in this Incident Action Plan):</span>
    </div>
    <div class="attachments-grid">
      <% @attachments.each do |a| %>
        <div class="attachment-cell">
          <span class="attachment-checkbox"><%= a.attached ? '☑' : '☐' %></span>
          <span class="attachment-description"><%= a.description %></span>
        </div>
      <% end %>
    </div>
  </div>

  <div class="sheet-section sheet-section-7">
    <div class="sheet-cell wide">
      <span class="sheet-cell-label strong">7. Prepared by:</span>
      <span class="text-center"><%= @plan.prepared_by %></span>
    </div>
    <div class="sheet-cell narrow">
      <span class="sheet-cell-label">Position/Title:</span>
      <span class="text-center"><%= @plan.prepared_by_position %></span>
    </div>
    <div class="sheet-cell narrow">
      <span class="sheet-cell-label">Signature:</span>
    </div>
  </div>

  <div class="sheet-section sheet-section-8">
    <div class="sheet-cell wide">
      <span class="sheet-cell-label strong">8. Approved by Incident Commander:</span>
      <span class="text-center"><%= @plan.approved_by %></span>
    </div>
    <div class="sheet-cell narrow">
      <span class="sheet-cell-label">Signature:</span>
    </div>
    <div class="sheet-cell narrow">
      <span class="sheet-cell-label">Date/Time:</span>
      <span class="sheet-cell-value">
        <%= [@plan.date_prepare&.strftime('%m/%d/%Y'), @plan.time_prepared].compact.join(' ') %>
      </span>
    </div>
  </div>

  <div class="sheet-section sheet-meta">
    <div class="sheet-cell form-id">ICS 202</div>
    <div class="sheet-cell iap-page">IAP Page</div>
    <div class="sheet-cell status">FINAL</div>
    <div class="sheet-cell page-num">Page 1 of 1</div>
  </div>
</div>
