<%= content_for :title, "202" %>
<%
  # Split "0800 - 2200" into from/to for the Date/Time header cells.
  op_from, op_to = @plan.ops_period.to_s.split(/\s*[-–—]\s*/, 2).map(&:presence)
  date_str = @plan.date&.strftime('%m/%d/%Y')
%>

<%# Tabs — app chrome, live outside the fixed form sheet. %>
<div class="container">
  <div class="col-xs-12 col-lg-8 center-block">
    <div class="row">
      <div class="plan-panel-head">
        <ul class="tabrow">
          <li><%= link_to 'Plan', incident_plan_path(@incident, @plan) %></li>
          <li><%= link_to "Cover", incident_plan_covers_path(@incident, @plan) %></li>
          <li class="selected"><%= link_to "202", "../#{@plan.id}/202" %></li>
          <li><%= link_to "203", "../#{@plan.id}/203" %></li>
          <li><%= link_to "204", incident_plan_assignments_path(@incident, @plan) %></li>
          <li><%= link_to "205", incident_plan_commo_plans_path(@incident, @plan) %></li>
          <li><%= link_to "206", '#' %></li>
          <li><%= link_to "220", '#' %></li>
          <li><%= link_to "Safety Message", incident_plan_safety_messages_path(@incident, @plan) %></li>
        </ul>
      </div>
      <div class="masking-tape"></div>
    </div>
  </div>
</div>

<%# ─── ICS 202 sheet ─── Fixed 7.5"×10" flex column. No Bootstrap
    grid inside — sections are flex children with fixed heights (or
    flex:1 for the three expandable text sections). Sheet's own border
    handles the outer edge; inner sections have only border-bottom. %>
<div class="ics-form-sheet ics-202-sheet">

  <div class="sheet-section sheet-title">
    INCIDENT OBJECTIVES (ICS 202)
  </div>

  <div class="sheet-section sheet-header">
    <div class="sheet-header-left">
      <div class="sheet-header-label">1. Incident Name:</div>
      <div class="sheet-header-value"><%= @incident.name %></div>
    </div>
    <div class="sheet-header-right">
      <div class="sheet-header-op">
        <span>2. Operational Period:</span>
        <strong style="margin-left: 8px;">DAY</strong>
      </div>
      <div class="sheet-header-dates">
        <div class="sheet-header-date">
          <div class="sheet-header-label">Date/Time From:</div>
          <div class="sheet-header-value"><%= [date_str, op_from].compact.join(' ') %></div>
        </div>
        <div class="sheet-header-date">
          <div class="sheet-header-label">Date/Time To:</div>
          <div class="sheet-header-value"><%= [date_str, op_to].compact.join(' ') %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="sheet-section sheet-text sheet-objectives">
    <div class="sheet-text-label">3. Objective(s):</div>
    <div class="sheet-text-body">
      <%= best_in_place @plan, :objectives_text, as: :textarea,
                        place_holder: "(ADD OBJECTIVES)",
                        display_with: :simple_format %>
    </div>
  </div>

  <div class="sheet-section sheet-text sheet-emphasis">
    <div class="sheet-text-label">4. Operational Period Command Emphasis:</div>
    <div class="sheet-text-body">
      <%= best_in_place @plan, :weather, as: :textarea,
                        place_holder: "(ADD CONTENT)",
                        display_with: :simple_format %>
    </div>
  </div>

  <div class="sheet-section sheet-text sheet-awareness">
    <div class="sheet-text-label">General Situational Awareness:</div>
    <div class="sheet-text-body">
      <%= best_in_place @plan, :general_safety, as: :textarea,
                        place_holder: "(ADD CONTENT)",
                        display_with: :simple_format %>
    </div>
  </div>

  <div class="sheet-section sheet-section-5">
    <span class="sheet-text-label" style="margin: 0;">5. Site Safety Plan Required?</span>
    <%# Placeholder — real checkbox wiring comes in Phase 2. %>
    <span>Yes ☐&nbsp;&nbsp;&nbsp;No ☐</span>
    <span>Approved Site Safety Plan(s) Located at:
      <%= best_in_place @plan, :site_safety_plan_location, as: :input, place_holder: "(Location)" %>
    </span>
  </div>

  <div class="sheet-section sheet-section-6">
    <div class="sheet-text-label">6. Incident Action Plan
      <span style="font-weight: 400;">(the items checked below are included in this Incident Action Plan):</span>
    </div>
    <%# Placeholder — 3×6 grid built in Phase 3. %>
    <div style="color:#6b778c; font-style: italic;">
      Attachments grid — coming in Phase 3.
    </div>
  </div>

  <div class="sheet-section sheet-section-7">
    <div class="sheet-cell wide">
      <span class="sheet-cell-label">7. Prepared by:</span>
      <span class="sheet-cell-value">
        <%= best_in_place @plan, :prepared_by, as: :input, place_holder: '(NAME)' %>
      </span>
    </div>
    <div class="sheet-cell narrow">
      <span class="sheet-cell-label">Position/Title:</span>
      <span class="sheet-cell-value">
        <%= best_in_place @plan, :prepared_by_position, as: :input, place_holder: '(POSITION)' %>
      </span>
    </div>
    <div class="sheet-cell narrow">
      <span class="sheet-cell-label">Signature:</span>
    </div>
  </div>

  <div class="sheet-section sheet-section-8">
    <div class="sheet-cell wide">
      <span class="sheet-cell-label">8. Approved by Incident Commander:</span>
      <span class="sheet-cell-value">
        <%= best_in_place @plan, :approved_by, as: :input, place_holder: '(NAME)' %>
      </span>
    </div>
    <div class="sheet-cell narrow">
      <span class="sheet-cell-label">Signature:</span>
    </div>
    <div class="sheet-cell narrow">
      <span class="sheet-cell-label">Date/Time:</span>
      <span class="sheet-cell-value">
        <%= [@plan.date_prepare&.strftime('%m/%d/%Y'), @plan.time_prepared].compact.join(' ') %>
      </span>
    </div>
  </div>

  <div class="sheet-section sheet-meta">
    <div class="sheet-cell form-id">ICS 202</div>
    <div class="sheet-cell iap-page">IAP Page</div>
    <div class="sheet-cell status">FINAL</div>
    <div class="sheet-cell page-num">Page 1 of 1</div>
  </div>
</div>

<div class="ics-202-page-actions">
  <a href="#" id="print-link" class="btn btn-success tiny" target="_blank">PRINT</a>
</div>

<script>
  // Simple print link — Phase 5 will align the PDF template to render
  // the same sheet, so no need to pass row-height params anymore.
  document.addEventListener('turbolinks:load', function () {
    var link = document.getElementById('print-link');
    if (!link) return;
    link.addEventListener('click', function (e) {
      e.preventDefault();
      window.open('../<%= @plan.id %>/202-pdf.pdf', '_blank');
    });
  });
</script>
