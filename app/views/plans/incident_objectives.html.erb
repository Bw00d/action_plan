<%= content_for :title, "202" %>

<%# Tabs — app chrome, live outside the fixed form sheet. %>
<div class="container">
  <div class="col-xs-12 col-lg-8 center-block">
    <div class="row">
      <div class="plan-panel-head">
        <ul class="tabrow">
          <li><%= link_to 'Plan', incident_plan_path(@incident, @plan) %></li>
          <li><%= link_to "Cover", incident_plan_covers_path(@incident, @plan) %></li>
          <li class="selected"><%= link_to "202", "../#{@plan.id}/202" %></li>
          <li><%= link_to "203", "../#{@plan.id}/203" %></li>
          <li><%= link_to "204", incident_plan_assignments_path(@incident, @plan) %></li>
          <li><%= link_to "205", incident_plan_commo_plans_path(@incident, @plan) %></li>
          <li><%= link_to "206", '#' %></li>
          <li><%= link_to "220", '#' %></li>
          <li><%= link_to "Safety Message", incident_plan_safety_messages_path(@incident, @plan) %></li>
        </ul>
      </div>
      <div class="masking-tape"></div>
    </div>
  </div>
</div>

<%# ─── ICS 202 sheet ─── Fixed 7.5"×10" flex column. No Bootstrap
    grid inside — sections are flex children with fixed heights (or
    flex:1 for the three expandable text sections). Sheet's own border
    handles the outer edge; inner sections have only border-bottom. %>
<div class="ics-form-sheet ics-202-sheet" data-plan-id="<%= @plan.id %>">

  <div class="sheet-section sheet-title">
    INCIDENT OBJECTIVES (ICS 202)
  </div>

  <div class="sheet-section sheet-header">
    <div class="sheet-header-left">
      <div class="sheet-header-label">1. Incident Name:</div>
      <div class="sheet-header-value"><%= @incident.name %></div>
    </div>
    <div class="sheet-header-right">
      <div class="sheet-header-op">
        <span class="sheet-header-op-label">2. Operational Period:</span>
        <%# Click the value to switch between DAY / NIGHT. Defaults to
            DAY at the DB layer (migration backfills existing rows). %>
        <%= best_in_place @plan, :shift,
                          as: :select,
                          collection: [["DAY", "DAY"], ["NIGHT", "NIGHT"]],
                          class: "sheet-header-op-value" %>
      </div>
      <div class="sheet-header-dates">
        <%# Date/Time From / To — flatpickr with auto-save PATCH,
            same pattern as the 204 ops period. Fields are datetime
            columns on Plan; setters parse "MM/DD/YYYY HHMM". %>
        <% [:ops_period_from, :ops_period_to].each_with_index do |field, i| %>
          <div class="sheet-header-date">
            <div class="sheet-header-label"><%= i.zero? ? "Date/Time From:" : "Date/Time To:" %></div>
            <div class="sheet-header-value">
              <input type="text"
                     class="sheet-dt-picker"
                     data-url="<%= incident_plan_path(@incident, @plan) %>"
                     data-field="plan[<%= field %>]"
                     value="<%= @plan.public_send(field)&.strftime('%m/%d/%Y %H:%M') %>"
                     placeholder="MM/DD/YYYY HH:MM">
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="sheet-section sheet-text sheet-objectives" data-section-key="objectives">
    <div class="sheet-text-label">3. Objective(s):</div>
    <div class="sheet-text-body">
      <%= best_in_place @plan, :objectives_text, as: :textarea,
                        place_holder: "(ADD OBJECTIVES)",
                        display_with: :simple_format %>
    </div>
  </div>

  <%# Draggable divider — adjusts space between Objectives and Emphasis
      only. Awareness is unaffected. See JS at bottom of this file. %>
  <div class="sheet-divider" data-above="objectives" data-below="emphasis"
       title="Drag to resize"></div>

  <div class="sheet-section sheet-text sheet-emphasis" data-section-key="emphasis">
    <div class="sheet-text-label">4. Operational Period Command Emphasis:</div>
    <div class="sheet-text-body">
      <%= best_in_place @plan, :weather, as: :textarea,
                        place_holder: "(ADD CONTENT)",
                        display_with: :simple_format %>
    </div>
  </div>

  <div class="sheet-divider" data-above="emphasis" data-below="awareness"
       title="Drag to resize"></div>

  <div class="sheet-section sheet-text sheet-awareness" data-section-key="awareness">
    <div class="sheet-text-label">General Situational Awareness:</div>
    <div class="sheet-text-body">
      <%= best_in_place @plan, :general_safety, as: :textarea,
                        place_holder: "(ADD CONTENT)",
                        display_with: :simple_format %>
    </div>
  </div>

  <div class="sheet-section sheet-section-5">
    <span class="sheet-text-label sheet-inline-label">5. Site Safety Plan Required?</span>

    <%# Two mutually-exclusive checkboxes bound to a string field
        ("Yes" / "No" / nil). JS at the bottom PATCHes via AJAX and
        clears when a checked box is clicked a second time. %>
    <span class="ssp-toggle-group"
          data-field="site_safety_plan_required"
          data-url="<%= incident_plan_path(@incident, @plan) %>">
      <label class="ssp-check">
        <span class="ssp-check-label">Yes</span>
        <input type="checkbox" class="ssp-check-input" data-value="Yes"
               <%= 'checked' if @plan.site_safety_plan_required == 'Yes' %>>
      </label>
      <label class="ssp-check">
        <span class="ssp-check-label">No</span>
        <input type="checkbox" class="ssp-check-input" data-value="No"
               <%= 'checked' if @plan.site_safety_plan_required == 'No' %>>
      </label>
    </span>

    <span class="ssp-location">
      <span>Approved Site Safety Plan(s) Located at:</span>
      <%= best_in_place @plan, :site_safety_plan_location, as: :input, place_holder: "(Location)" %>
    </span>
  </div>

  <div class="sheet-section sheet-section-6">
    <div class="sheet-text-label">6. Incident Action Plan
      <span class="sheet-normal">(the items checked below are included in this Incident Action Plan):</span>
    </div>
    <%# 3-column grid, column-first flow so slots 1–6 stack in the left
        column, 7–12 in the middle, 13–18 on the right. Every slot is
        editable — pre-seeded names (ICS 202, 203, ...) are just
        defaults the user can rename. %>
    <div class="attachments-grid">
      <% @attachments.each do |a| %>
        <div class="attachment-cell">
          <%= best_in_place a, :attached, as: :checkbox,
                            collection: { false => raw("&#x2610;"), true => raw("&#x2611;") },
                            class: "attachment-checkbox" %>
          <%= best_in_place a, :description, as: :input,
                            place_holder: "____________________",
                            class: "attachment-description" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="sheet-section sheet-section-7">
    <div class="sheet-cell wide">
      <span class="sheet-cell-label">7. Prepared by:</span>
      <span class="sheet-cell-value">
        <%= best_in_place @plan, :prepared_by, as: :input, place_holder: '(NAME)' %>
      </span>
    </div>
    <div class="sheet-cell narrow">
      <span class="sheet-cell-label">Position/Title:</span>
      <span class="sheet-cell-value">
        <%= best_in_place @plan, :prepared_by_position, as: :input, place_holder: '(POSITION)' %>
      </span>
    </div>
    <div class="sheet-cell narrow">
      <span class="sheet-cell-label">Signature:</span>
    </div>
  </div>

  <div class="sheet-section sheet-section-8">
    <div class="sheet-cell wide">
      <span class="sheet-cell-label">8. Approved by Incident Commander:</span>
      <span class="sheet-cell-value">
        <%= best_in_place @plan, :approved_by, as: :input, place_holder: '(NAME)' %>
      </span>
    </div>
    <div class="sheet-cell narrow">
      <span class="sheet-cell-label">Signature:</span>
    </div>
    <div class="sheet-cell narrow">
      <span class="sheet-cell-label">Date/Time:</span>
      <span class="sheet-cell-value">
        <%= [@plan.date_prepare&.strftime('%m/%d/%Y'), @plan.time_prepared].compact.join(' ') %>
      </span>
    </div>
  </div>

  <div class="sheet-section sheet-meta">
    <div class="sheet-cell form-id">ICS 202</div>
    <div class="sheet-cell iap-page">IAP Page</div>
    <div class="sheet-cell status">FINAL</div>
    <div class="sheet-cell page-num">Page 1 of 1</div>
  </div>
</div>

<div class="ics-202-page-actions">
  <a href="#" id="print-link" class="btn btn-success tiny" target="_blank">PRINT</a>
</div>

<script>
  document.addEventListener('turbolinks:load', function () {
    // ── Print link ─────────────────────────────────────────
    // Passes the current section flex-grow ratios (from localStorage)
    // as URL params so the PDF renders the same layout the user set
    // on-screen. Controller parses them into @section_ratios; PDF
    // template applies via inline style="flex-grow:...".
    var link = document.getElementById('print-link');
    if (link) {
      link.addEventListener('click', function (e) {
        e.preventDefault();
        var url = '../<%= @plan.id %>/202-pdf.pdf';
        try {
          var raw = localStorage.getItem('ics202-ratios-<%= @plan.id %>');
          var r   = raw && JSON.parse(raw);
          if (r && r.objectives && r.emphasis && r.awareness) {
            url += '?objectives=' + encodeURIComponent(r.objectives) +
                   '&emphasis='   + encodeURIComponent(r.emphasis) +
                   '&awareness='  + encodeURIComponent(r.awareness);
          }
        } catch (_) {}
        window.open(url, '_blank');
      });
    }

    // ── Date/Time From / To pickers ────────────────────────
    // Same pattern as the 204's .op-dt-picker: flatpickr enables the
    // calendar+time popup, onChange auto-PATCHes plan[field] via
    // jQuery AJAX. Setter on Plan (parse_ops_datetime) parses the
    // "MM/DD/YYYY HH:MM" string back to a Time.zone datetime.
    if (typeof flatpickr !== "undefined") {
      flatpickr(".sheet-dt-picker", {
        enableTime: true,
        time_24hr:  true,
        dateFormat: "m/d/Y H:i",
        allowInput: true,
        onChange: function (selectedDates, dateStr, instance) {
          var $el  = $(instance.input);
          var data = {};
          data[$el.data("field")] = dateStr;
          $.ajax({ url: $el.data("url"), type: "PATCH", data: data, dataType: "json" });
        }
      });
    }

    // ── Site Safety Plan Required? — mutually-exclusive checkboxes ─
    // Clicking either box PATCHes plan[site_safety_plan_required] with
    // "Yes" / "No" / "" (empty = clear). Sibling auto-unchecks so only
    // one can be selected at a time.
    document.querySelectorAll('.sheet-section-5 .ssp-toggle-group').forEach(function (group) {
      var field = group.dataset.field;
      var url   = group.dataset.url;
      var boxes = group.querySelectorAll('.ssp-check-input');
      boxes.forEach(function (box) {
        box.addEventListener('change', function () {
          var picked = '';
          if (box.checked) {
            picked = box.dataset.value;
            boxes.forEach(function (b) { if (b !== box) b.checked = false; });
          }
          var token = document.querySelector('meta[name="csrf-token"]');
          var body  = { plan: {} };
          body.plan[field] = picked;
          fetch(url, {
            method: 'PATCH',
            credentials: 'same-origin',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
              'X-CSRF-Token': token ? token.content : ''
            },
            body: JSON.stringify(body)
          });
        });
      });
    });

    // ── Draggable dividers between the three text sections ─────────
    // Each divider redistributes space between its two adjacent
    // sections only. Ratios (flex-grow values) are saved to
    // localStorage per plan id so the layout persists across visits.
    // Min-height 60px per section stops a user from dragging one to
    // zero and losing access.
    (function () {
      var sheet = document.querySelector('.ics-202-sheet');
      if (!sheet) return;
      var planId = sheet.dataset.planId;
      var sections = {
        objectives: sheet.querySelector('[data-section-key="objectives"]'),
        emphasis:   sheet.querySelector('[data-section-key="emphasis"]'),
        awareness:  sheet.querySelector('[data-section-key="awareness"]')
      };
      if (!sections.objectives || !sections.emphasis || !sections.awareness) return;

      var storageKey = 'ics202-ratios-' + planId;
      var saved = null;
      try { saved = JSON.parse(localStorage.getItem(storageKey) || 'null'); } catch (e) {}
      var ratios = saved && saved.objectives && saved.emphasis && saved.awareness
                   ? saved
                   : { objectives: 1, emphasis: 1, awareness: 1 };

      function applyRatios() {
        sections.objectives.style.flexGrow = ratios.objectives;
        sections.emphasis.style.flexGrow   = ratios.emphasis;
        sections.awareness.style.flexGrow  = ratios.awareness;
      }
      applyRatios();

      var MIN_PX = 60;

      sheet.querySelectorAll('.sheet-divider').forEach(function (div) {
        var aboveKey = div.dataset.above;
        var belowKey = div.dataset.below;
        var aboveEl  = sections[aboveKey];
        var belowEl  = sections[belowKey];
        if (!aboveEl || !belowEl) return;

        div.addEventListener('mousedown', function (e) {
          e.preventDefault();
          div.classList.add('dragging');
          var startY       = e.clientY;
          var aboveStartH  = aboveEl.offsetHeight;
          var belowStartH  = belowEl.offsetHeight;
          var totalPx      = aboveStartH + belowStartH;
          var totalRatio   = ratios[aboveKey] + ratios[belowKey];

          function onMove(ev) {
            var deltaY  = ev.clientY - startY;
            var newAbove = Math.max(MIN_PX, Math.min(totalPx - MIN_PX, aboveStartH + deltaY));
            var proportion = newAbove / totalPx;
            ratios[aboveKey] = totalRatio * proportion;
            ratios[belowKey] = totalRatio * (1 - proportion);
            applyRatios();
          }
          function onUp() {
            document.removeEventListener('mousemove', onMove);
            document.removeEventListener('mouseup',   onUp);
            div.classList.remove('dragging');
            try { localStorage.setItem(storageKey, JSON.stringify(ratios)); } catch (e) {}
          }
          document.addEventListener('mousemove', onMove);
          document.addEventListener('mouseup',   onUp);
        });
      });

      // ── Overflow badges ────────────────────────────────────────
      // Watch each text-body — if content is taller than visible
      // area, show a warning badge on the section label.
      function checkOverflow() {
        Object.keys(sections).forEach(function (key) {
          var section = sections[key];
          var body    = section.querySelector('.sheet-text-body');
          var label   = section.querySelector('.sheet-text-label');
          if (!body || !label) return;
          var overflowing = body.scrollHeight > body.clientHeight + 1;
          var badge = label.querySelector('.sheet-overflow-badge');
          if (overflowing && !badge) {
            badge = document.createElement('span');
            badge.className = 'sheet-overflow-badge';
            badge.textContent = '⚠ May not fit when printed';
            badge.title = 'This section has more text than fits — drag the divider to give it more room, or trim the text.';
            label.appendChild(badge);
          } else if (!overflowing && badge) {
            badge.remove();
          }
        });
      }
      if (window.ResizeObserver) {
        var ro = new ResizeObserver(checkOverflow);
        Object.values(sections).forEach(function (s) {
          ro.observe(s);
          var body = s.querySelector('.sheet-text-body');
          if (body) ro.observe(body);
        });
      }
      checkOverflow();
    })();
  });
</script>
