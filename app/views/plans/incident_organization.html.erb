<%= content_for :title, "203" %>
<%
  # Compute how many empty pad rows to render at the bottom of each column
  # so both columns end at the same y. Each section takes
  # 1 header + max(min, count) data + 1 blank-add row. Column target is the
  # taller of the two columns' natural row count, floored at 41 (the row
  # capacity of a Letter page at 22px so PDFs fill cleanly).
  # No more per-section row minimums — each section shrinks to its
  # actual content (1 header + N entries + 1 blank-add row). The
  # column-target pad rows at the bottom of each column still fill any
  # remaining space so both columns end at the same y. Removing the
  # minimums also drops the "3 empty rows in Command" complaint.
  cmd_rows = 1 + @plan.command_staff.count + 1
  agy_rows = 1 + @plan.agency_reps.count   + 1
  pln_rows = 1 + @plan.plans.count         + 1
  log_rows = 1 + @plan.logistics.count     + 1
  ops_rows = 1 + @plan.operations.count    + 1
  fin_rows = 1 + @plan.finance.count       + 1

  # No more per-column top rows — title / incident name / dates now live in
  # a shared full-width header above .org-columns (matches ICS 203 form).
  # Overflow decision — Logistics stays anchored at the bottom of the
  # left column but any of its rows that don't fit spill to the TOP of
  # the right column (no repeated header). Preserves the standard ICS
  # 203 layout in the common case; only individual excess rows move.
  #
  # Left budget for Logistics = page - (Cmd + Agy + Plan). If the full
  # section fits, no overflow. Otherwise: header + K entries stay left,
  # remaining (n - K) entries + blank-add row move to right.
  # Row budget per column. 37 physical rows @ 22px = 814px, which fits
  # under the ~824px available after header (~90px) and footer (~65px)
  # in a Letter page with 0.4in margins. Wrap-heavy plans may still
  # overflow — we revisit with actual measurement if that becomes common.
  page_budget    = 37
  fixed_left     = cmd_rows + agy_rows + pln_rows
  right_natural  = ops_rows + fin_rows
  log_count      = @plan.logistics.count

  if fixed_left + log_rows <= page_budget
    # Normal — full Logistics fits on the left.
    @overflow_logistics = false
    @logistics_header_on_right = false
    @left_log_entries  = log_count
    @right_log_entries = 0
    left_used  = fixed_left + log_rows
    right_used = right_natural
  else
    # Overflow — split. Left holds the section header + as many entries
    # as fit; the rest spill to the top of the right column (no repeated
    # header, plus a blank-add row so users can still add entries).
    # When no entries at all fit on the left (fixed_left already
    # saturates the page), the Logistics header moves to the right too.
    @overflow_logistics = true
    left_log_capacity  = page_budget - fixed_left - 1  # -1 for section header
    @left_log_entries  = [[left_log_capacity, log_count].min, 0].max
    @right_log_entries = log_count - @left_log_entries
    @logistics_header_on_right = (@left_log_entries == 0)

    left_header_row  = @left_log_entries > 0 ? 1 : 0
    right_header_row = @logistics_header_on_right ? 1 : 0
    left_used  = fixed_left + left_header_row + @left_log_entries
    right_used = right_header_row + @right_log_entries + 1 + right_natural  # +1 blank-add
  end

  column_target   = [left_used, right_used, page_budget].max
  @left_pad_rows  = column_target - left_used
  @right_pad_rows = column_target - right_used

  # Split "0800 - 2200" style ops_period into from / to halves for the
  # standard-form Date/Time header cells. Gracefully falls back to the
  # whole string in "from" if there's no separator.
  op_from, op_to = @plan.ops_period.to_s.split(/\s*[-–—]\s*/, 2).map(&:presence)
  date_str = @plan.date&.strftime('%m/%d/%Y')
%>
<div id="organization-assignments">
  <div class="container">
    <div class="col-xs-12 col-lg-8 center-block">


      <div class="row">
        <div class="plan-panel-head">
          <ul class="tabrow">
            <li><%= link_to 'Plan', incident_plan_path(@incident, @plan) %></li>
            <li><%= link_to "Cover", incident_plan_covers_path(@incident, @plan)  %></li>
            <li><%= link_to "202", "../#{@plan.id}/202" %></li>
            <li class="selected"><%= link_to "203", "../#{@plan.id}/203" %></li>
            <li><%= link_to "204", incident_plan_assignments_path(@incident, @plan) %></li>
            <li><%= link_to "205", incident_plan_commo_plans_path(@incident, @plan) %></li>
            <li><%= link_to "206", '#' %></li>
            <li><%= link_to "220", '#' %></li>
            <li><%= link_to "Safety Message", incident_plan_safety_messages_path(@incident, @plan) %></li>
          </ul>
          </div>
        <div class="masking-tape"></div>
      </div>
  


      <!-- Full-width ICS 203 header -->

      <div class="row org-header">
        <div id="title-box" class="col-xs-12 content-box">
          <h4><strong>ORGANIZATION ASSIGNMENT LIST (ICS 203)</strong></h4>
        </div>
      </div>
      <div class="row org-header">
        <div class="col-xs-4 content-box org-header-cell org-header-tall">
          <div class="org-header-label gray-row content-box strong"><span class="small">1. Incident Name:</span></div>
          <div class="org-header-value"><%= @incident.name %></div>
        </div>
        <div class="col-xs-8 org-header-right">
          <div class="row">
            <div class="col-xs-12 content-box op-period-cell">
              <span class="small strong">2. Operational Period:</span>
              <span class="lg-padding-left"><strong>DAY</strong></span>
            </div>
          </div>
          <div class="row">
            <div class="col-xs-6 content-box org-header-cell">
              <div class="org-header-label"><span class="small">Date/Time From:</span></div>
              <div class="org-header-value"><%= [date_str, op_from].compact.join(' ') %></div>
            </div>
            <div class="col-xs-6 content-box org-header-cell">
              <div class="org-header-label"><span class="small">Date/Time To:</span></div>
              <div class="org-header-value"><%= [date_str, op_to].compact.join(' ') %></div>
            </div>
          </div>
        </div>
      </div>

      <div class="row org-columns">
        <div class="left-column col-xs-6"> <!-- Left Column-->
         <%#  <div class="row no-print">
            <div class="col-xs-12 org-wrap-tip">
              Tip: combine multiple people on one row with <code>;</code> —
              e.g. <em>John Smith; Betty Lee; Mark Johnson</em>. Saves rows on long sections.
            </div>
          </div> %>
          <div class="row">
            <div class="col-xs-12 content-box header-row strong text-left">3. Command</div>
          </div>

          <!-- BEGIN Command Staff -->
          <% @plan.command_staff.each do |s| %>
            <%= render 'org_row', team: s %>
          <% end %>
            <div class="row blank-row">
              <div class="content-box col-xs-6">
                <span class="team-form">
                  <%= form_for @team do |f| %>
                    <%= f.hidden_field :staff, value: "Command" %>
                    <%= f.hidden_field :plan_id, value: @plan.id %>
                  <%# resource_name and position deliberately not set —
                      the row starts nil and the _org_row.html.erb partial
                      renders "(POSITION)" / "(NAME)" as a place_holder
                      only, so the PDF prints blank cells. %>
                  <%= f.button type: :submit, class: "add-org-btn", title: "Add position" do %>
                    <%= image_tag 'user-plus.svg', class: 'add-org-icon' %>
                  <% end %>
                <% end %>
              </span>
              <span class="team-form">
                <%= form_for @team do |f| %>
                  <%= f.hidden_field :staff, value: "Command" %>
                  <%= f.hidden_field :plan_id, value: @plan.id %>
                  <%= f.button type: :submit, class: "add-org-btn", title: "Add blank position" do %>
                    <%= image_tag 'user-plus.svg', class: 'add-org-icon' %>
                  <% end %>
                <% end %>
              </span>
            </div>
              <div class="content-box col-xs-6"></div>
            </div>
          <!-- END Command Staff -->
          <!-- BEGIN Agency Admins -->
          <div class="row">
            <div class="content-box col-xs-12 header-row">4. Agency Representatives</div>     <!-- Agency Reps-->        
          </div>
          <% @plan.agency_reps.each do |s| %>
            <%= render 'org_row', team: s %>
          <% end %>
            <div class="row blank-row">
              <div class="content-box col-xs-6">
                <span class="team-form">
                  <%= form_for @team do |f| %>
                    <%= f.hidden_field :staff, value: "Agency" %>
                    <%= f.hidden_field :plan_id, value: @plan.id %>
                  <%# resource_name and position deliberately not set —
                      the row starts nil and the _org_row.html.erb partial
                      renders "(POSITION)" / "(NAME)" as a place_holder
                      only, so the PDF prints blank cells. %>
                  <%= f.button type: :submit, class: "add-org-btn", title: "Add position" do %>
                    <%= image_tag 'user-plus.svg', class: 'add-org-icon' %>
                  <% end %>
                <% end %>
              </span>
              <span class="team-form">
                <%= form_for @team do |f| %>
                  <%= f.hidden_field :staff, value: "Agency" %>
                  <%= f.hidden_field :plan_id, value: @plan.id %>
                  <%= f.button type: :submit, class: "add-org-btn", title: "Add blank position" do %>
                    <%= image_tag 'user-plus.svg', class: 'add-org-icon' %>
                  <% end %>
                <% end %>
              </span>
            </div>      
              <div class="content-box col-xs-6"></div>      
            </div>
          <!-- END Agency Admins -->
          <!-- START Plans -->
          <div class="row">
            <div class="content-box col-xs-12 header-row">5. Planning Section</div>     <!-- Planning Section-->        
          </div>
          <% @plan.plans.each do |s| %>
            <%= render 'org_row', team: s %>
          <% end %>
            <div class="row blank-row">
              <div class="content-box col-xs-6">
                <span class="team-form">
                  <%= form_for @team do |f| %>
                    <%= f.hidden_field :staff, value: "Plans" %>
                    <%= f.hidden_field :plan_id, value: @plan.id %>
                  <%# resource_name and position deliberately not set —
                      the row starts nil and the _org_row.html.erb partial
                      renders "(POSITION)" / "(NAME)" as a place_holder
                      only, so the PDF prints blank cells. %>
                  <%= f.button type: :submit, class: "add-org-btn", title: "Add position" do %>
                    <%= image_tag 'user-plus.svg', class: 'add-org-icon' %>
                  <% end %>
                <% end %>
              </span>
              <span class="team-form">
                <%= form_for @team do |f| %>
                  <%= f.hidden_field :staff, value: "Plans" %>
                  <%= f.hidden_field :plan_id, value: @plan.id %>
                  <%= f.button type: :submit, class: "add-org-btn", title: "Add blank position" do %>
                    <%= image_tag 'user-plus.svg', class: 'add-org-icon' %>
                  <% end %>
                <% end %>
              </span>
            </div>
              <div class="content-box col-xs-6"></div>
            </div>
          <!-- END Plans -->
          <%# Logistics — normally sits here in full. On overflow, either
              header + K entries render here (K > 0) or nothing renders
              here and the whole section moves to the top of the right
              column (K == 0 → header goes right too). %>
          <% if !@overflow_logistics %>
            <%= render 'logistics_section' %>
          <% elsif @left_log_entries > 0 %>
            <div class="row">
              <div class="content-box col-xs-12 header-row">6. Logistics Section</div>
            </div>
            <% @plan.logistics.first(@left_log_entries).each do |s| %>
              <%= render 'org_row', team: s %>
            <% end %>
          <% end %>

          <%# Real DOM rows to pad the column down to the target height so
              its bottom lands at the same y as the right column's bottom.
              Real rows render crisp 1px borders (unlike the gradient
              approach, which anti-aliased into gray in the PDF). %>
          <% @left_pad_rows.times do %>
            <div class="row">
              <div class="col-xs-6 content-box"></div>
              <div class="col-xs-6 content-box"></div>
            </div>
          <% end %>

        </div> <!-- END LEFT COLUMN-->

        <div class="right-column col-xs-6"> <!-- START RIGHT COLUMN-->
          <%# Logistics overflow — continuation rows plus the blank-add
              row. When nothing fit on the left, also render the section
              header here so the section reads as a coherent block. %>
          <% if @overflow_logistics %>
            <% if @logistics_header_on_right %>
              <div class="row">
                <div class="content-box col-xs-12 header-row">6. Logistics Section</div>
              </div>
            <% end %>
            <% @plan.logistics.drop(@left_log_entries).each do |s| %>
              <%= render 'org_row', team: s %>
            <% end %>
            <div class="row blank-row">
              <div class="content-box col-xs-6">
                <span class="team-form">
                  <%= form_for @team do |f| %>
                    <%= f.hidden_field :staff, value: "Logistics" %>
                    <%= f.hidden_field :plan_id, value: @plan.id %>
                    <%= f.button type: :submit, class: "add-org-btn", title: "Add position" do %>
                      <%= image_tag 'user-plus.svg', class: 'add-org-icon' %>
                    <% end %>
                  <% end %>
                </span>
                <span class="team-form">
                  <%= form_for @team do |f| %>
                    <%= f.hidden_field :staff, value: "Logistics" %>
                    <%= f.hidden_field :plan_id, value: @plan.id %>
                    <%= f.button type: :submit, class: "add-org-btn", title: "Add blank position" do %>
                      <%= image_tag 'user-plus.svg', class: 'add-org-icon' %>
                    <% end %>
                  <% end %>
                </span>
              </div>
              <div class="content-box col-xs-6"></div>
            </div>
          <% end %>
          <!-- START Ops -->
          <div class="row">
            <div class="col-xs-12 content-box header-row">7. Operations Section</div>
          </div>
          <% @plan.operations.each do |s| %>
            <%= render 'org_row', team: s %>
          <% end %>
            <div class="row blank-row">
              <div class="content-box col-xs-6">
                <span class="team-form">
                  <%= form_for @team do |f| %>
                    <%= f.hidden_field :staff, value: "Operations" %>
                    <%= f.hidden_field :plan_id, value: @plan.id %>
                  <%# resource_name and position deliberately not set —
                      the row starts nil and the _org_row.html.erb partial
                      renders "(POSITION)" / "(NAME)" as a place_holder
                      only, so the PDF prints blank cells. %>
                  <%= f.button type: :submit, class: "add-org-btn", title: "Add position" do %>
                    <%= image_tag 'user-plus.svg', class: 'add-org-icon' %>
                  <% end %>
                <% end %>
              </span>
              <span class="team-form">
                <%= form_for @team do |f| %>
                  <%= f.hidden_field :staff, value: "Operations" %>
                  <%= f.hidden_field :plan_id, value: @plan.id %>
                  <%= f.button type: :submit, class: "add-org-btn", title: "Add blank position" do %>
                    <%= image_tag 'user-plus.svg', class: 'add-org-icon' %>
                  <% end %>
                <% end %>
              </span>
            </div>
              <div class="content-box col-xs-6">
                <span class="team-form">
                  <%= form_for @team do |f| %>
                    <%= f.hidden_field :staff, value: "Operations" %>
                    <%= f.hidden_field :plan_id, value: @plan.id %>
                    <%= f.hidden_field :header_label, value: "HEADER" %>
                  <%= f.button type: :submit, class: "add-org-btn add-header-btn", title: "Add header row" do %>
                    <%= fa_icon 'header' %>
                  <% end %>
                <% end %>
              </span>
              </div>
            </div>
          <!-- END Ops -->
          <!-- BEGIN Finance (right column) -->
          <div class="row">
            <div class="content-box col-xs-12 header-row">8. Finance Section</div>
          </div>
          <% @plan.finance.each do |s| %>
            <%= render 'org_row', team: s %>
          <% end %>
            <div class="row blank-row">
              <div class="content-box col-xs-6">
                <span class="team-form">
                  <%= form_for @team do |f| %>
                    <%= f.hidden_field :staff, value: "Finance" %>
                    <%= f.hidden_field :plan_id, value: @plan.id %>
                  <%# resource_name and position deliberately not set —
                      the row starts nil and the _org_row.html.erb partial
                      renders "(POSITION)" / "(NAME)" as a place_holder
                      only, so the PDF prints blank cells. %>
                  <%= f.button type: :submit, class: "add-org-btn", title: "Add position" do %>
                    <%= image_tag 'user-plus.svg', class: 'add-org-icon' %>
                  <% end %>
                <% end %>
              </span>
              <span class="team-form">
                <%= form_for @team do |f| %>
                  <%= f.hidden_field :staff, value: "Finance" %>
                  <%= f.hidden_field :plan_id, value: @plan.id %>
                  <%= f.button type: :submit, class: "add-org-btn", title: "Add blank position" do %>
                    <%= image_tag 'user-plus.svg', class: 'add-org-icon' %>
                  <% end %>
                <% end %>
              </span>
            </div>
              <div class="content-box col-xs-6"></div>
            </div>
          <!-- END Finance (right column) -->

          <%# Real DOM rows to pad the column down to the target height. %>
          <% @right_pad_rows.times do %>
            <div class="row">
              <div class="col-xs-6 content-box"></div>
              <div class="col-xs-6 content-box"></div>
            </div>
          <% end %>

        </div> <!-- END RIGHT COLUMN -->
      </div> 
        <div class="row org-footer">
          <div class="content-box col-xs-5">
            <span class="small strong">9. Prepared By:</span>
            <span class="lg-padding-left">
              <%= best_in_place @plan, :prepared_by, as: :input, id: "org-name", place_holder: '  ' %>
            </span>
          </div>
          <div class="content-box col-xs-3">
            <span class="small">Position/Title:</span>
            <span class="lg-padding-left">
              <%= best_in_place @plan, :prepared_by_position, as: :input, id: "org-position", place_holder: '  ' %>
            </span>
          </div>
          <div class="content-box col-xs-4 bottom-row">
            <span class="small">Signature:</span>
          </div>
        </div>
        <div class="row org-footer">
          <div class="content-box col-xs-2"><strong>ICS 203</strong></div>
          <div class="content-box col-xs-3">IAP Page</div>
          <div class="content-box col-xs-3">
            <span class="small">Date/Time:</span>
            <span class="lg-padding-left">
              <%= [@plan.date_prepare&.strftime('%m/%d/%Y'), @plan.time_prepared].compact.join(' ') %>
            </span>
          </div>
          <div class="content-box col-xs-4 bottom-row"></div>
        </div>
        <div class="row org-footer-meta">
          <div class="col-xs-6 text-center"><strong>FINAL</strong></div>
          <div class="col-xs-6 text-right">Page 1 of 1</div>
        </div>

    <div class="print-button"><%= link_to "PRINT", "../#{@plan.id}/203-pdf.pdf", class: "btn btn-success tiny", target: :_blank %></div>
    </div>
  </div>
</div>