  <%= form_for [@incident, @plan] do |f| %>
  <% if plan.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(plan.errors.count, "error") %> prohibited this plan from being saved:</h2>

      <ul>
      <% plan.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :date %>
    <%= f.text_field :date, id: :plan_date, :data => {:provide => "datepicker"},
                      class: "datepicker form-control", placeholder: "DATE", required: true %>
   <%= f.hidden_field :incident_id, value: @incident.id, class: 'form-control' %>
    <%= f.hidden_field :user_id, value: current_user.id, class: 'form-control' %>
  </div>

  <%# Operational period start + end — stored on the plan and inherited
      by every new ICS-204 (and other dated forms) created under this
      plan. The 204's own fields stay editable per assignment; this is
      just the default seed.
      Date uses the shared bootstrap-datepicker (same as the plan date
      above); time stays a 4-char text input (HHMM). JS below composes
      them into the hidden ops_period_from/to fields that the model's
      parse_ops_datetime setter expects. %>
  <% from_date = f.object.ops_period_from&.strftime("%m/%d/%Y") %>
  <% from_time = f.object.ops_period_from&.strftime("%H%M") %>
  <% to_date   = f.object.ops_period_to&.strftime("%m/%d/%Y") %>
  <% to_time   = f.object.ops_period_to&.strftime("%H%M") %>

  <div class="form-group">
    <%= f.label :ops_period_from, "Operational Period — From" %>
    <div class="ops-period-row">
      <input type="text" class="datepicker form-control ops-period-date"
             data-ops-target="from" placeholder="MM/DD/YYYY"
             autocomplete="off" value="<%= from_date %>">
      <input type="text" class="form-control ops-period-time"
             data-ops-target="from" placeholder="HHMM"
             inputmode="numeric" maxlength="4" value="<%= from_time %>">
    </div>
    <%= f.hidden_field :ops_period_from,
                       class: "ops-period-combined",
                       data: { ops_target: "from" },
                       value: [from_date, from_time].reject(&:blank?).join(" ") %>
  </div>

  <div class="form-group">
    <%= f.label :ops_period_to, "Operational Period — To" %>
    <div class="ops-period-row">
      <input type="text" class="datepicker form-control ops-period-date"
             data-ops-target="to" placeholder="MM/DD/YYYY"
             autocomplete="off" value="<%= to_date %>">
      <input type="text" class="form-control ops-period-time"
             data-ops-target="to" placeholder="HHMM"
             inputmode="numeric" maxlength="4" value="<%= to_time %>">
    </div>
    <%= f.hidden_field :ops_period_to,
                       class: "ops-period-combined",
                       data: { ops_target: "to" },
                       value: [to_date, to_time].reject(&:blank?).join(" ") %>
  </div>

  <script>
    (function () {
      // Compose "<date> <time>" into the hidden field whenever either
      // of the visible pickers changes, so the server sees the same
      // "MM/DD/YYYY HHMM" string the model's parse_ops_datetime expects.
      function syncOpsPeriod(target) {
        var $date = $('.ops-period-date[data-ops-target="' + target + '"]');
        var $time = $('.ops-period-time[data-ops-target="' + target + '"]');
        var $comb = $('.ops-period-combined[data-ops-target="' + target + '"]');
        var d = ($date.val() || '').trim();
        var t = ($time.val() || '').trim();
        $comb.val(d && t ? (d + ' ' + t) : d);
      }
      ['from', 'to'].forEach(function (target) {
        var selector = '.ops-period-date[data-ops-target="' + target + '"], ' +
                       '.ops-period-time[data-ops-target="' + target + '"]';
        $(document).on('change input changeDate', selector, function () {
          syncOpsPeriod(target);
        });
      });
    })();
  </script>

  <style>
    .ops-period-row { display: flex; gap: 8px; }
    .ops-period-row .ops-period-date { flex: 1; }
    .ops-period-row .ops-period-time { width: 90px; flex: 0 0 90px; text-align: center; }
  </style>



  <div class="actions">
    <%= f.submit class: 'btn btn-primary' %>
  </div>
<% end %>
