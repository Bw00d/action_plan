  <%= form_for [@incident, @plan] do |f| %>
  <% if plan.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(plan.errors.count, "error") %> prohibited this plan from being saved:</h2>

      <ul>
      <% plan.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :date %>
    <%= f.text_field :date, id: :plan_date, :data => {:provide => "datepicker"},
                      class: "datepicker form-control", placeholder: "DATE", required: true %>
   <%= f.hidden_field :incident_id, value: @incident.id, class: 'form-control' %>
    <%= f.hidden_field :user_id, value: current_user.id, class: 'form-control' %>
  </div>

  <%# Operational period start + end — stored on the plan and inherited
      by every new ICS-204 (and other dated forms) created under this
      plan. The 204's own fields stay editable per assignment; this is
      just the default seed. Parser accepts "MM/DD/YYYY HHMM" or any
      format Time.zone.parse understands (see Plan#ops_period_from=). %>
  <div class="form-group">
    <%= f.label :ops_period_from, "Operational Period — From (date + time)" %>
    <%= f.text_field :ops_period_from,
                      class: "form-control",
                      placeholder: "MM/DD/YYYY HHMM",
                      value: f.object.ops_period_from&.strftime("%m/%d/%Y %H%M") %>
  </div>
  <div class="form-group">
    <%= f.label :ops_period_to, "Operational Period — To (date + time)" %>
    <%= f.text_field :ops_period_to,
                      class: "form-control",
                      placeholder: "MM/DD/YYYY HHMM",
                      value: f.object.ops_period_to&.strftime("%m/%d/%Y %H%M") %>
  </div>



  <div class="actions">
    <%= f.submit class: 'btn btn-primary' %>
  </div>
<% end %>
