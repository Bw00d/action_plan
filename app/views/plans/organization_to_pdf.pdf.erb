
<%
  # Same column-target math as the HTML view — see incident_organization.html.erb.
  # Same as the HTML editor — no per-section minimums; sections shrink
  # to their actual content and the column-target pad rows fill the rest.
  cmd_rows = 1 + @plan.command_staff.count + 1
  agy_rows = 1 + @plan.agency_reps.count   + 1
  pln_rows = 1 + @plan.plans.count         + 1
  log_rows = 1 + @plan.logistics.count     + 1
  ops_rows = 1 + @plan.operations.count    + 1
  fin_rows = 1 + @plan.finance.count       + 1

  # Same overflow logic as the HTML editor — Logistics stays anchored
  # at the bottom of the left column; only the excess rows spill to the
  # top of the right column so the 203 stays on a single page.
  page_budget   = 32
  fixed_left    = cmd_rows + agy_rows + pln_rows
  right_natural = ops_rows + fin_rows
  log_count     = @plan.logistics.count

  if fixed_left + log_rows <= page_budget || fixed_left >= page_budget
    @overflow_logistics = false
    left_used  = fixed_left + log_rows
    right_used = right_natural
    @left_log_entries  = log_count
    @right_log_entries = 0
  else
    @overflow_logistics = true
    left_log_capacity  = page_budget - fixed_left - 1
    @left_log_entries  = [[left_log_capacity, log_count].min, 0].max
    @right_log_entries = log_count - @left_log_entries
    left_used  = fixed_left + 1 + @left_log_entries
    right_used = @right_log_entries + 1 + right_natural
  end

  column_target   = [left_used, right_used, page_budget].max
  @left_pad_rows  = column_target - left_used
  @right_pad_rows = column_target - right_used

  op_from, op_to = @plan.ops_period.to_s.split(/\s*[-–—]\s*/, 2).map(&:presence)
  date_str = @plan.date&.strftime('%m/%d/%Y')
%>
<div id="organization-assignments">
  <div class="container">
      
    <div class="col-xs-12 col-lg-8 center-block">

      <!-- Full-width ICS 203 header -->
      <div class="row org-header">
        <div id="title-box" class="col-xs-12 content-box">
          <h4><strong>ORGANIZATION ASSIGNMENT LIST (ICS 203)</strong></h4>
        </div>
      </div>
      <div class="row org-header">
        <div class="col-xs-4 content-box org-header-cell org-header-tall">
          <div class="org-header-label gray-row content-box"><span class="small">1. Incident Name:</span></div>
          <div class="org-header-value"><%= @incident.name %></div>
        </div>
        <div class="col-xs-8 org-header-right">
          <div class="row">
            <div class="col-xs-12 content-box op-period-cell gray-row">
              <span class="small">2. Operational Period:</span>
              <span class="lg-padding-left"><strong>DAY</strong></span>
            </div>
          </div>
          <div class="row">
            <div class="col-xs-6 content-box org-header-cell">
              <div class="org-header-label"><span class="small">Date/Time From:</span></div>
              <div class="org-header-value"><%= [date_str, op_from].compact.join(' ') %></div>
            </div>
            <div class="col-xs-6 content-box org-header-cell">
              <div class="org-header-label"><span class="small">Date/Time To:</span></div>
              <div class="org-header-value"><%= [date_str, op_to].compact.join(' ') %></div>
            </div>
          </div>
        </div>
      </div>

      <div class="row org-columns">
        <div class="left-column col-xs-6"> <!-- Left Column-->
          <div class="row">
            <div class="col-xs-12 content-box header-row"> COMMAND AND GENERAL STAFF </div>
          </div>

          <!-- BEGIN Command Staff -->
          <% @plan.command_staff.each do |s| %>
            <%= render 'org_row_pdf', team: s %>
          <% end %>
            <div class="row blank-row">
              <div class="content-box col-xs-6">
                
            </div>      
              <div class="content-box col-xs-6"></div>      
            </div>
          <!-- END Command Staff -->
          <!-- BEGIN Agency Admins -->
          <div class="row">
            <div class="content-box col-xs-12 header-row">AGENCY REPRESENTATIVES</div>     <!-- Agency Reps-->        
          </div>
          <% @plan.agency_reps.each do |s| %>
            <%= render 'org_row_pdf', team: s %>
          <% end %>
            <div class="row blank-row">
              <div class="content-box col-xs-6">
                
            </div>      
              <div class="content-box col-xs-6"></div>      
            </div>
          <!-- END Agency Admins -->
          <!-- START Plans -->
          <div class="row">
            <div class="content-box col-xs-12 header-row">PLANNING SECTION</div>     <!-- Planning Section-->        
          </div>
          <% @plan.plans.each do |s| %>
            <%= render 'org_row_pdf', team: s %>
          <% end %>
            <div class="row blank-row">
              <div class="content-box col-xs-6">
                
            </div>      
              <div class="content-box col-xs-6"></div>      
            </div>
          <!-- END Plans -->
          <% if @overflow_logistics %>
            <div class="row">
              <div class="content-box col-xs-12 header-row">LOGISTICS SECTION</div>
            </div>
            <% @plan.logistics.first(@left_log_entries).each do |s| %>
              <%= render 'org_row_pdf', team: s %>
            <% end %>
          <% else %>
            <%= render 'logistics_section_pdf' %>
          <% end %>

          <% @left_pad_rows.times do %>
            <div class="row">
              <div class="col-xs-6 content-box"></div>
              <div class="col-xs-6 content-box"></div>
            </div>
          <% end %>

        </div> <!-- END LEFT COLUMN-->

        <div class="right-column col-xs-6"> <!-- START RIGHT COLUMN-->
          <%# Logistics overflow — continuation rows without a repeated
              header, plus a trailing blank row to visually cap the
              section before OPERATIONS begins. %>
          <% if @overflow_logistics %>
            <% @plan.logistics.drop(@left_log_entries).each do |s| %>
              <%= render 'org_row_pdf', team: s %>
            <% end %>
            <div class="row blank-row">
              <div class="content-box col-xs-6"></div>
              <div class="content-box col-xs-6"></div>
            </div>
          <% end %>
          <!-- START Ops -->
          <div class="row">
            <div class="col-xs-12 content-box header-row"> OPERATIONS </div>
          </div>
          <% @plan.operations.each do |s| %>
            <%= render 'org_row_pdf', team: s %>
          <% end %>
            <div class="row blank-row">
              <div class="content-box col-xs-6">
                
            </div>      
              <div class="content-box col-xs-6"></div>      
            </div>
          <!-- END Ops -->
          <!-- BEGIN Finance (right column) -->
          <div class="row">
            <div class="content-box col-xs-12 header-row">FINANCE SECTION</div>
          </div>
          <% @plan.finance.each do |s| %>
            <%= render 'org_row_pdf', team: s %>
          <% end %>
            <div class="row blank-row">
              <div class="content-box col-xs-6">
            </div>
              <div class="content-box col-xs-6"></div>
            </div>
          <!-- END Finance (right column) -->

          <% @right_pad_rows.times do %>
            <div class="row">
              <div class="col-xs-6 content-box"></div>
              <div class="col-xs-6 content-box"></div>
            </div>
          <% end %>

        </div> <!-- END RIGHT COLUMN -->
      </div> 
        <div class="row org-footer">
          <div class="content-box col-xs-5">
            <span class="small">9. Prepared By:</span>
            <span class="lg-padding-left"><%= @plan.prepared_by %></span>
          </div>
          <div class="content-box col-xs-3">
            <span class="small">Position/Title:</span>
            <span class="lg-padding-left"><%= @plan.prepared_by_position %></span>
          </div>
          <div class="content-box col-xs-4 bottom-row">
            <span class="small">Signature:</span>
          </div>
        </div>
        <div class="row org-footer">
          <div class="content-box col-xs-2"><strong>ICS 203</strong></div>
          <div class="content-box col-xs-2">IAP Page</div>
          <div class="content-box col-xs-5">
            <span class="small">Date/Time:</span>
            <span class="lg-padding-left">
              <%= [@plan.date_prepare&.strftime('%m/%d/%Y'), @plan.time_prepared].compact.join(' ') %>
            </span>
          </div>
          <div class="content-box col-xs-3 bottom-row"></div>
        </div>
        <div class="row org-footer-meta">
          <div class="col-xs-6 text-center"><strong>FINAL</strong></div>
          <div class="col-xs-6 text-right">Page 1 of 1</div>
        </div>

    </div>
  </div>
</div>
<script type="text/javascript">
    $(document).on("turbolinks:load", function() {
      $('#header').hide();
      $('.footer').hide();
      $('.header-row').css('background-color', "#f3f3f3");
      $('.gray-row').css('background-color', "#f3f3f3");
      $('body').css("padding-top", 25);
      $('body').css("padding-right", 10);
      $('body').css("padding-left", 10);
    });
  </script>