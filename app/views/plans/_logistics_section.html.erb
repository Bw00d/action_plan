<%# Logistics section for the 203 (HTML editor).
    Rendered in the left column by default; auto-reflows to the top of
    the right column when @reflow_logistics is true (left would overflow
    the page and Logistics fits on the right). Same markup either way —
    only the position changes. %>
<div class="row">
  <div class="content-box col-xs-12 header-row">6. Logistics Section</div>
</div>
<% @plan.logistics.each do |s| %>
  <%= render 'org_row', team: s %>
<% end %>
<div class="row blank-row">
  <div class="content-box col-xs-6">
    <span class="team-form">
      <%= form_for @team do |f| %>
        <%= f.hidden_field :staff, value: "Logistics" %>
        <%= f.hidden_field :plan_id, value: @plan.id %>
        <%= f.button type: :submit, class: "add-org-btn", title: "Add position" do %>
          <%= image_tag 'user-plus.svg', class: 'add-org-icon' %>
        <% end %>
      <% end %>
    </span>
    <span class="team-form">
      <%= form_for @team do |f| %>
        <%= f.hidden_field :staff, value: "Logistics" %>
        <%= f.hidden_field :plan_id, value: @plan.id %>
        <%= f.button type: :submit, class: "add-org-btn", title: "Add blank position" do %>
          <%= image_tag 'user-plus.svg', class: 'add-org-icon' %>
        <% end %>
      <% end %>
    </span>
  </div>
  <div class="content-box col-xs-6"></div>
</div>
