<%= content_for :title, "Check In Resource" %>

<div class="checkin-page">
  <div class="incident-name">
    <h1><%= link_to @incident.display_incident_name, @incident %></h1>
  </div>

  <div class="checkin-header">
    <% if @request %>
      <h2>Check In: <%= @request.req_number %></h2>
      <p class="muted">
        <%= @request.req_catalog_name %>
        <% if @request.filled_catalog_item_name.present? %>
          &nbsp;·&nbsp; <%= @request.filled_catalog_item_name %>
        <% end %>
      </p>
    <% else %>
      <h2>Check In: <%= @remote_checkin.display_req_number.presence || 'no request number' %></h2>
      <p class="muted">
        No matching request on this incident. If the number was mistyped,
        fix the category and order number below — a match is linked on save.
      </p>
    <% end %>
  </div>

  <% if @remote_checkin %>
    <div class="alert alert-info rc-promote-banner">
      <strong>Promoting self-reported check-in from
        <%= @remote_checkin.name.presence || 'unknown resource' %></strong>
      submitted <%= time_ago_in_words(@remote_checkin.submitted_at) %> ago.
      Fields are pre-filled from the submission — edit as needed, then Check In.
    </div>
  <% end %>

  <div id="glide-info" class="panel panel-default">
    <div id="resource-form">
      <h4><strong>New Resource</strong></h4>

      <%= form_for @resource,
                   url: @request ? incident_request_checkin_path(@incident, @request)
                                 : incident_remote_checkin_checkin_path(@incident, @remote_checkin),
                   local: true do |f| %>
        <% if @resource.errors.any? %>
          <div id="error_explanation">
            <h2><%= pluralize(@resource.errors.count, "error") %> prohibited this resource from being saved:</h2>
            <ul>
              <% @resource.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= f.hidden_field :incident_id, value: @incident.id %>
        <% if @remote_checkin %>
          <%= hidden_field_tag 'remote_checkin_id', @remote_checkin.id %>
        <% end %>

        <div class="form-group">
          <%= f.text_field :name, placeholder: "RESOURCE NAME", class: 'form-control', required: true %>
        </div>

        <div class="form-group">
          <%= f.select :category,
                       options_for_select([["CREW", "CREW"], ["EQUIPMENT", "EQUIPMENT"], ["OVERHEAD", "OVERHEAD"], ["AIRCRAFT", "AIRCRAFT"]], @resource.category),
                       { prompt: "SELECT CATEGORY" },
                       id: :resource_category, class: 'form-control', required: true %>
        </div>

        <div class="form-group">
          <%= f.text_field :position, placeholder: "RESOURCE KIND/TYPE", class: 'form-control', required: true %>
        </div>

        <div id="order-number-input" class="form-group">
          <span class="order-number-prefix"></span>
          <%= f.text_field :order_number, placeholder: "ORDER NUMBER", class: 'form-control', required: true %>
        </div>

        <div class="form-group">
          <%= f.text_field :leader, placeholder: "LEADER NAME", class: 'form-control' %>
        </div>

        <div class="form-group">
          <%= f.text_field :number_personnel, placeholder: "# PERSONNEL", class: 'form-control', required: true %>
        </div>

        <div class="form-group">
          <%= f.text_field :agency, placeholder: "AGENCY", class: 'form-control', required: true %>
        </div>

        <div class="row">
          <div class="col-md-6 form-group">
            <%= f.telephone_field :phone, placeholder: "CELL PHONE", class: 'form-control' %>
          </div>
          <div class="col-md-6 form-group">
            <%= f.email_field :email, placeholder: "EMAIL", class: 'form-control' %>
          </div>
        </div>

        <div class="row">
          <div class="col-md-5">
            <%= f.text_field :checkin_date, id: :incident_checkin_date, :data => {:provide => "datepicker"},
                                             class: "datepicker form-control", placeholder: "CHECKIN DATE", required: true %>
          </div>
          <div class="col-md-5 form-group">
            <%= f.text_field :fwd, id: :incident_fwd, :data => {:provide => "datepicker"},
                                   class: "datepicker form-control", placeholder: "FIRST WORK DAY", required: true %>
          </div>
          <div class="col-md-2 form-group">
            <%= f.text_field :assignment_length,
                                   class: "form-control", placeholder: "ASSIGNMENT LENGTH", required: true %>
          </div>
        </div>

        <div class="form-group">
          <%= f.text_field :jetport, placeholder: "JETPORT", class: 'form-control' %>
        </div>

        <div class="row">
          <div class="col-md-8 form-group">
            <%= f.text_field :return_city, placeholder: "RETURN CITY", class: 'form-control' %>
          </div>
          <div class="col-md-4 form-group">
            <%= f.text_field :return_state, placeholder: "RETURN STATE", class: 'form-control' %>
          </div>
        </div>

        <%# Additional details — collected by the public remote-checkin
            form; exposed here so dispatchers can fill them in for
            walk-ups too. All optional; blank values stay nil. %>
        <fieldset class="form-group">
          <legend class="small text-muted">Additional details (optional)</legend>

          <div class="form-group">
            <%= f.text_field :agency_address, placeholder: "AGENCY ADDRESS", class: 'form-control' %>
          </div>
          <div class="form-group">
            <%= f.text_field :emergency_contact, placeholder: "EMERGENCY CONTACT (name + phone)", class: 'form-control' %>
          </div>
          <div class="row">
            <div class="col-md-4 form-group">
              <%= f.text_field :mobilization_date, id: :resource_mobilization_date,
                               data: { provide: 'datepicker' },
                               class: 'datepicker form-control',
                               placeholder: 'MOBILIZATION DATE' %>
            </div>
            <div class="col-md-8 form-group">
              <%= f.select :transportation_method,
                           options_for_select(RemoteCheckin::TRANSPORTATION_METHODS, @resource.transportation_method),
                           { prompt: 'TRANSPORTATION METHOD' },
                           class: 'form-control' %>
            </div>
          </div>

          <div class="form-group">
            <label class="checkbox-inline">
              <%= f.check_box :from_other_incident %>
              Came from another incident immediately before this one
            </label>
          </div>
          <div class="row">
            <div class="col-md-5 form-group">
              <%= f.text_field :other_incident_name, placeholder: "PREVIOUS INCIDENT NAME", class: 'form-control' %>
            </div>
            <div class="col-md-3 form-group">
              <%= f.text_field :other_incident_req_number, placeholder: "PREVIOUS REQ #", class: 'form-control' %>
            </div>
            <div class="col-md-4 form-group">
              <%= f.text_field :prev_incident_first_day_worked,
                               id: :resource_prev_first_day,
                               data: { provide: 'datepicker' },
                               class: 'datepicker form-control',
                               placeholder: 'FIRST DAY WORKED (PREV)' %>
            </div>
          </div>
        </fieldset>

        <div class="row">
          <div class="form-group col-md-6">
            <%= f.submit "Check In", class: 'btn btn-primary', id: "submit-resource-button" %>
          </div>
          <div class="col-md-6">
            <%= link_to "Cancel", @request ? incident_requests_path(@incident) : incident_remote_checkins_path(@incident),
                                  class: 'btn btn-default btn-wide' %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
