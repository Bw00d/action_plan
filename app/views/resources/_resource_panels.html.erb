<%# Floating detail modals for every assigned resource. Rendered once at
    page level so they float above whichever tab is active — opened by
    double-clicking an ICS-211 row or by clicking a resource link on the
    glide path / other tabs. %>
<% if !@incident.resources.empty? %>
  <% natural_order_sort(@resources.assigned).each do |r| %>
    <div id="resource-panel-<%= r.id %>" class="resource-panel is-hidden" data-resource-panel="<%= r.id %>">
      <div class="resource-panel-inner">
        <button type="button" class="resource-panel-close" aria-label="Close">&times;</button>
        <h3 class="resource-panel-title">
          <%= r.full_order_number %> &middot; <%= r.name %>
        </h3>

        <div class="resource-panel-fields">
          <div class="resource-panel-field">
            <label>Order #</label>
            <span><%= r.cat %><%= best_in_place r, :order_number, as: :input %></span>
          </div>
          <div class="resource-panel-field">
            <label>Kind / Type</label>
            <%= best_in_place r, :position, as: :input, place_holder: "---" %>
          </div>
          <div class="resource-panel-field">
            <label>Name</label>
            <%= best_in_place r, :name, as: :input, place_holder: "---" %>
          </div>
          <div class="resource-panel-field">
            <label>Leader</label>
            <%= best_in_place r, :leader, as: :input, place_holder: "---" %>
          </div>
          <div class="resource-panel-field">
            <label># Personnel</label>
            <%= best_in_place r, :number_personnel, as: :input, place_holder: "---" %>
          </div>
          <div class="resource-panel-field">
            <label>Agency</label>
            <%= best_in_place r, :agency, as: :input, place_holder: "---" %>
          </div>
          <div class="resource-panel-field">
            <label>First Work Day</label>
            <%= best_in_place r, :fwd, display_as: :formatted_fwd, place_holder: "---" %>
          </div>
          <div class="resource-panel-field">
            <label>Assignment Length</label>
            <%= best_in_place r, :assignment_length, as: :input, place_holder: "---" %>
          </div>
          <div class="resource-panel-field">
            <label>Last Work Day</label>
            <span class="static-field"><%= r.last_work_day.try(:strftime, "%m/%d") || "—" %></span>
          </div>
          <div class="resource-panel-field">
            <label>Phone</label>
            <%= best_in_place r, :phone, as: :input, place_holder: "---" %>
          </div>
          <div class="resource-panel-field">
            <label>Email</label>
            <%= best_in_place r, :email, as: :input, place_holder: "---" %>
          </div>
          <div class="resource-panel-field">
            <label>Jetport</label>
            <%= best_in_place r, :jetport, as: :input, place_holder: "---" %>
          </div>
          <div class="resource-panel-field">
            <label>Return City</label>
            <%= best_in_place r, :return_city, as: :input, place_holder: "---" %>
          </div>
          <div class="resource-panel-field">
            <label>Return State</label>
            <%= best_in_place r, :return_state, as: :input, place_holder: "---" %>
          </div>
          <div class="resource-panel-field">
            <label>Check-In Date</label>
            <%= best_in_place r, :checkin_date, as: :input, place_holder: "---",
                              display_with: ->(v) { v&.strftime('%m/%d/%Y') } %>
          </div>
          <div class="resource-panel-field">
            <label>Drop Off Pt / Time</label>
            <%= best_in_place r, :drop_off_pt_time, as: :input, place_holder: "---" %>
          </div>
          <div class="resource-panel-field">
            <label>Pick Up Pt / Time</label>
            <%= best_in_place r, :pick_up_pt_time, as: :input, place_holder: "---" %>
          </div>

          <%# Check-in details — captured by the remote check-in form (or
              the manual check-in form for walk-ups). %>
          <h4 class="resource-panel-section resource-panel-field-wide">Check-In Details</h4>
          <div class="resource-panel-field resource-panel-field-wide">
            <label>Agency Address</label>
            <%= best_in_place r, :agency_address, as: :input, place_holder: "---" %>
          </div>
          <div class="resource-panel-field">
            <label>Emergency Contact</label>
            <%= best_in_place r, :emergency_contact, as: :input, place_holder: "---" %>
          </div>
          <div class="resource-panel-field">
            <label>Mobilization Date</label>
            <%= best_in_place r, :mobilization_date, as: :input, place_holder: "---",
                              display_with: ->(v) { v&.strftime('%m/%d/%Y') } %>
          </div>
          <div class="resource-panel-field">
            <label>Transportation</label>
            <%= best_in_place r, :transportation_method, as: :select, place_holder: "---",
                              collection: ([['', '---']] + RemoteCheckin::TRANSPORTATION_METHODS.map { |m| [m, m] }) %>
          </div>

          <h4 class="resource-panel-section resource-panel-field-wide">Previous Incident</h4>
          <div class="resource-panel-field">
            <label>From Another Incident</label>
            <%= best_in_place r, :from_other_incident, as: :checkbox, collection: { false => 'No', true => 'Yes' } %>
          </div>
          <div class="resource-panel-field">
            <label>Incident Name</label>
            <%= best_in_place r, :other_incident_name, as: :input, place_holder: "---" %>
          </div>
          <div class="resource-panel-field">
            <label>Request #</label>
            <%= best_in_place r, :other_incident_req_number, as: :input, place_holder: "---" %>
          </div>
          <div class="resource-panel-field">
            <label>First Day Worked There</label>
            <%= best_in_place r, :prev_incident_first_day_worked, as: :input, place_holder: "---",
                              display_with: ->(v) { v&.strftime('%m/%d/%Y') } %>
          </div>

          <div class="resource-panel-field resource-panel-field-wide">
            <label>Notes</label>
            <%= best_in_place r, :notes, as: :textarea, place_holder: "Click to add notes…",
                                         display_with: :simple_format,
                                         html_attrs: { style: 'width:100%; min-height:60px;' } %>
          </div>
          <div class="resource-panel-field resource-panel-field-wide">
            <label>Comment</label>
            <%= best_in_place r, :comment, as: :textarea, place_holder: "Click to add comment…",
                                           html_attrs: { style: 'width:100%; min-height:80px;' },
                                           ok_button: 'Save',   ok_button_class: 'btn btn-info tiny',
                                           cancel_button: 'Cancel', cancel_button_class: 'btn btn-default sm-margin-left tiny' %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
