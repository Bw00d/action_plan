<div id="glide-info" class="panel panel-default">
  <div id="resource-form">
    <h4><strong>New Resource</strong></h4>
      <%= render 'new_resource_form' %>
    </div>
<!-- Default panel contents -->
  <% if !@incident.resources.empty? %>
    <%# Section filter. Checkboxes are all checked by default; unchecking
        one hides rows tagged with that section. Resource#ics_section
        tags the row via data-section (lowercase); resources with no
        classification stay visible only when every box is checked. %>
    <div class="glide-section-filter no-print" data-incident-id="<%= @incident.id %>">
      <span class="glide-section-filter-label">Sections:</span>
      <% Resource::ICS_SECTIONS.each do |sec| %>
        <label class="glide-section-filter-option">
          <input type="checkbox" class="glide-section-filter-checkbox"
                 value="<%= sec.downcase %>" checked>
          <%= sec %>
        </label>
      <% end %>
    </div>
    <!-- Table -->
    <table class="table">
      <thead>
        <tr>
          <th colspan="4" rowspan="2" class="glide-title-cell">
            <%= @incident.name %> <%= @incident.incident_type %> Glide Path
          </th>
          <% 14.times do |t| %>
            <th class="glide-header glide-calendar" scope="col"><%= t + 1 %></th>
          <% end %>
        </tr>
        <tr>
          <% 14.times do |t| %>
            <th class="glide-header glide-calendar" scope="col"><%= (Time.zone.today + t.days).strftime('%a') %></th>
          <% end %>
        </tr>
        <tr>
          <th scope="col" class="table-col">Order#</th>
          <th scope="col" class="table-col">Position</th>
          <th scope="col" class="table-col name-col">Name</th>
          <th scope="col" class="table-col">LWD</th>
          <% 14.times do |t| %>
            <th class="glide-header glide-calendar" scope="col"><%= (Time.zone.today + t.days).strftime('%m/%d') %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @tally_resources.assigned.each do |r|  %>
        <%# Swap indicator — scheduled takes precedence over completed so
            the yellow "upcoming" pulse wins when both exist. In-memory
            walk of the already-loaded resource_events; no extra query. %>
        <% has_scheduled = r.resource_events.any?(&:scheduled_swap?) %>
        <% has_completed = r.resource_events.any?(&:completed_swap?) %>
        <tr data-section="<%= r.ics_section&.downcase %>">
          <td class=" table-col">
            <a href="javascript:;" class="glide-order-link"
               data-resource-id="<%= r.id %>"
               title="Edit resource details"><%= r.full_order_number %></a>
          </td>
          <td class=" table-col"><%=  r.position%></td>
          <td class="table-col name-col">
            <%= r.name %>
            <% if has_scheduled %>
              <i class="fa fa-exchange glide-swap-icon glide-swap-icon--scheduled"
                 title="Crew swap scheduled" aria-hidden="true"></i>
            <% elsif has_completed %>
              <i class="fa fa-exchange glide-swap-icon glide-swap-icon--completed"
                 title="Crew swap completed" aria-hidden="true"></i>
            <% end %>
          </td>
          <% if !r.last_work_day.blank? %>
            <td class=" table-col"><%=  r.last_work_day.strftime("%m/%d") %></td>
          <% else %>
          <td class=" table-col"></td>
          <% end %>

          <%# Days where a scheduled crew swap kicks in (FWD of the
              incoming operator). Precomputed per resource so the 14-day
              cell loop is just a Set include? check. %>
          <% swap_fwds = r.resource_events.select(&:scheduled_swap?)
                                           .map(&:fwd).compact.to_set %>
          <% 14.times do |d| %>
            <% cell_day = Time.zone.today + d.days %>
            <% is_swap  = swap_fwds.include?(cell_day) %>
            <td class="glide-calendar glide-row<%= ' glide-swap-day' if is_swap %>"
                data-day="<%= cell_day %>"
                data-lwd="<%= r.last_work_day %>"><%= 'SWAP' if is_swap %></td>
          <% end %>
        </tr>
        <% end %>

      </tbody>
    </table>

    <% else %>
    <div class="sm-padding-top md-padding-left">
      <h4>There are no resources assigned to this incident.</h4>
    </div>
  <% end %>


  <% if !@incident.resources.empty? %>
    <div class="glide-print-actions no-print">
      <button type="button" id="print-glide" class="btn btn-primary" onclick="printGlide()">
        <%= fa_icon 'print' %> Print Glide Path
      </button>
    </div>
  <% end %>
  <div class="panel-foot"></div>
</div>

<script>
  function printGlide() {
    document.body.classList.add('printing-glide');
    var style = document.createElement('style');
    style.id = 'print-orientation';
    style.textContent = '@page { size: landscape; margin: 0.4in; }';
    document.head.appendChild(style);

    var cleanup = function () {
      document.body.classList.remove('printing-glide');
      var s = document.getElementById('print-orientation');
      if (s) s.remove();
      window.removeEventListener('afterprint', cleanup);
    };
    window.addEventListener('afterprint', cleanup);
    window.print();
  }
</script>
