<style>
  @page { size: Letter landscape; margin: 0.4in; }
  html, body { margin: 0; padding: 0; font-family: Arial, Helvetica, sans-serif; color: #000; }
  h1 { font-size: 14pt; margin: 0 0 4pt; }
  .meta { font-size: 9pt; margin-bottom: 8pt; color: #333; }
  .meta span { margin-right: 12pt; }

  /* Wrap the table so JS can measure width and scale to fit the page. */
  .tally-wrap {
    transform-origin: 0 0;
    width: 100%;
  }

  table.tally {
    /* Grow with content — combined with the JS auto-fit below, wide
       tallies scale down to fit the landscape page instead of clipping. */
    width: auto;
    min-width: 100%;
    border-collapse: collapse;
    font-size: 8pt;
  }
  /* Force every cell (and thead/tbody/tr) to paint its background in
     print. Chrome's print-color-adjust doesn't always inherit down the
     table tree, so we set it on all descendants to be safe. Combined
     with Grover's print_background:true, this gives us the shaded
     agency rows / overhead / total columns in the PDF. */
  table.tally,
  table.tally *,
  table.tally thead,
  table.tally tbody,
  table.tally tr,
  table.tally th,
  table.tally td {
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
    color-adjust: exact !important;
  }
  table.tally th, table.tally td {
    border: 0.75pt solid #666;
    padding: 2pt 4pt;
    text-align: center;
    vertical-align: middle;
    white-space: nowrap;
  }
  /* Slightly stronger tones than the on-screen palette so shading
     stays visible at 8pt print. */
  table.tally thead th {
    background: #d9e2ec !important;
    font-weight: 600;
  }
  table.tally .agency-col { text-align: left; width: 18%; }
  table.tally .agency-cell {
    text-align: left;
    font-weight: 600;
    background: #eef1f5 !important;
  }
  table.tally .count-label {
    text-align: right;
    font-style: italic;
    color: #555;
    font-size: 8pt;
    background: #f5f6f8 !important;
  }
  table.tally .is-overhead { background: #ffe9c2 !important; }
  table.tally .is-total    { background: #d5e3ff !important; font-weight: 600; }
  table.tally .total-row td {
    background: #e3e6ec !important;
    font-weight: 700;
  }
  table.tally .total-row .is-overhead { background: #ffd88a !important; }
  table.tally .total-row .is-total    { background: #b8ceff !important; }
  .col-header { writing-mode: horizontal-tb; }
</style>

<h1><%= @incident.display_incident_name %> — Resource Tally</h1>
<div class="meta">
  <span><strong>Printed:</strong> <%= Time.current.strftime('%Y-%m-%d %H:%M') %></span>
</div>

<% pivot = resource_tally_pivot(@incident) %>

<% if pivot[:agencies].empty? %>
  <p><em>No assigned resources with a recognizable agency.</em></p>
<% else %>
  <div class="tally-wrap"><table class="tally">
    <thead>
      <tr>
        <th class="agency-col">Agency or Organization</th>
        <th></th>
        <% pivot[:columns].each do |col| %>
          <th class="col-header <%= 'is-overhead' if col[:overhead] %> <%= 'is-total' if col[:total] %>">
            <%= col[:label] %>
          </th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% pivot[:agencies].each do |agency| %>
        <% cells = pivot[:rows][agency] %>
        <tr>
          <td class="agency-cell" rowspan="2"><%= agency %></td>
          <td class="count-label">resources</td>
          <% pivot[:columns].each do |col| %>
            <% cell = cells[col[:key]] %>
            <td class="<%= 'is-overhead' if col[:overhead] %> <%= 'is-total' if col[:total] %>">
              <% unless col[:overhead] || col[:total] %>
                <%= cell[:resources].positive? ? cell[:resources] : '' %>
              <% end %>
            </td>
          <% end %>
        </tr>
        <tr>
          <td class="count-label">personnel</td>
          <% pivot[:columns].each do |col| %>
            <% cell = cells[col[:key]] %>
            <td class="<%= 'is-overhead' if col[:overhead] %> <%= 'is-total' if col[:total] %>">
              <%= cell[:personnel].positive? ? cell[:personnel] : '' %>
            </td>
          <% end %>
        </tr>
      <% end %>

      <tr class="total-row">
        <td class="agency-cell" rowspan="2">Total</td>
        <td class="count-label">resources</td>
        <% pivot[:columns].each do |col| %>
          <% t = pivot[:totals][col[:key]] %>
          <td class="<%= 'is-overhead' if col[:overhead] %> <%= 'is-total' if col[:total] %>">
            <% unless col[:overhead] || col[:total] %>
              <%= t[:resources].positive? ? t[:resources] : '' %>
            <% end %>
          </td>
        <% end %>
      </tr>
      <tr class="total-row">
        <td class="count-label">personnel</td>
        <% pivot[:columns].each do |col| %>
          <% t = pivot[:totals][col[:key]] %>
          <td class="<%= 'is-overhead' if col[:overhead] %> <%= 'is-total' if col[:total] %>">
            <%= t[:personnel].positive? ? t[:personnel] : '' %>
          </td>
        <% end %>
      </tr>
    </tbody>
  </table></div>
<% end %>

<script>
  // Auto-fit wide tallies to the landscape Letter page. Measure the
  // table's natural width; if it exceeds the printable width, scale the
  // whole wrap down so every column stays visible. Runs before Grover
  // captures the PDF (Puppeteer waits for the DOM to settle).
  (function () {
    var wrap  = document.querySelector('.tally-wrap');
    var table = wrap && wrap.querySelector('table.tally');
    if (!wrap || !table) return;
    // Landscape Letter minus 0.4in margins = 10.2in × 96dpi ≈ 979px.
    var pageWidth = 979;
    var natural   = table.scrollWidth;
    if (natural > pageWidth) {
      var scale = pageWidth / natural;
      wrap.style.transform = 'scale(' + scale + ')';
      // Compensate the parent height so any content below (footer text,
      // etc.) doesn't get pushed off the page.
      wrap.style.height = (table.scrollHeight * scale) + 'px';
    }
  })();
</script>
