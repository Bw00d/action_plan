<div id="tally-info" class="panel panel-default">
  <% if @resources.empty? %>
    <div class="sm-padding-top md-padding-left">
      <h4>There are no resources assigned to this incident.</h4>
    </div>
  <% else %>
    <% pivot = resource_tally_pivot(@incident) %>

    <div class="tally-container">
      <div class="tally-header">
        <div class="tally-header-actions no-print">
          <%# Both buttons open the Grover-generated PDF (landscape,
              auto-scaled to fit). window.print() can't reliably force
              landscape in Chrome — the injected @page rule is only a
              suggestion and the print dialog defaults to portrait —
              so we route the Print button through the PDF viewer too,
              where the PDF's baked-in orientation is respected. %>
          <%= link_to 'Download PDF',
                      tally_to_pdf_incident_resources_path(@incident, format: :pdf),
                      class: 'btn btn-primary btn-xs', target: :_blank %>
          <%= link_to 'Print',
                      tally_to_pdf_incident_resources_path(@incident, format: :pdf),
                      class: 'btn btn-default btn-xs tally-print-link',
                      target: :_blank,
                      title: "Opens the PDF in a new tab — hit Cmd/Ctrl+P from there." %>
        </div>
        <h2>RESOURCE TALLY</h2>
        <p class="muted">Live counts — updates automatically as resources check in or demob.</p>
      </div>

      <%= render partial: 'tally_pivot', locals: { pivot: pivot } %>

      <%# ── Daily tally: today + next 6 days ──────────────────────
          Today's panel shows the actual current roster — every
          resource that's checked in and not released, regardless of
          LWD (so late-staying resources still appear). Days 2-7
          project forward on the assumption that each resource demobs
          on its LWD, so they only include resources whose LWD is on
          or after the target date. All panels are pre-rendered —
          query cache means it's still just 2 SQL hits. %>
      <% today = Date.current %>
      <div class="tally-forecast no-print">
        <h3 class="tally-forecast-title">Daily Tally — Next 7 Days</h3>
        <p class="muted tally-forecast-sub">
          <strong>Today</strong> shows actual assigned resources regardless of LWD.
          Future days project the roster forward on the assumption that each
          resource demobs on its LWD; resources with no LWD are kept in every day's count.
        </p>

        <div class="tally-forecast-tabs" role="tablist">
          <% 7.times do |i| %>
            <% date = today + i %>
            <button type="button"
                    class="tally-forecast-tab <%= 'is-active' if i.zero? %>"
                    data-forecast-date="<%= date.iso8601 %>">
              <span class="tally-forecast-tab-dow"><%= i.zero? ? 'Today' : date.strftime('%a') %></span>
              <span class="tally-forecast-tab-date"><%= date.strftime('%-m/%-d') %></span>
            </button>
          <% end %>
        </div>

        <% 7.times do |i| %>
          <% date = today + i %>
          <%# Today = actual current roster (no LWD filter). Future
              days = projected using the on_date filter. %>
          <% day_pivot = i.zero? ? resource_tally_pivot(@incident)
                                 : resource_tally_pivot(@incident, on_date: date) %>
          <div class="tally-forecast-panel <%= 'is-active' if i.zero? %>"
               data-forecast-panel="<%= date.iso8601 %>"
               role="tabpanel">
            <h4 class="tally-forecast-panel-title">
              <%= i.zero? ? 'Today — ' : '' %><%= date.strftime('%A, %B %-d') %>
            </h4>
            <%= render partial: 'tally_pivot', locals: { pivot: day_pivot } %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
  <div class="panel-foot"></div>
</div>

<script>
  // Forecast tab switcher — toggles active class on buttons + panels.
  // Delegated so it survives Turbolinks swaps on the resources index.
  (function () {
    document.addEventListener('click', function (e) {
      var tab = e.target.closest('.tally-forecast-tab');
      if (!tab) return;
      var forecast = tab.closest('.tally-forecast');
      if (!forecast) return;
      var date = tab.getAttribute('data-forecast-date');
      forecast.querySelectorAll('.tally-forecast-tab').forEach(function (b) {
        b.classList.toggle('is-active', b === tab);
      });
      forecast.querySelectorAll('.tally-forecast-panel').forEach(function (p) {
        p.classList.toggle('is-active', p.getAttribute('data-forecast-panel') === date);
      });
    });
  })();
</script>
