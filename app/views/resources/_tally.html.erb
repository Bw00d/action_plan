<div id="tally-info" class="panel panel-default">
  <% if @resources.empty? %>
    <div class="sm-padding-top md-padding-left">
      <h4>There are no resources assigned to this incident.</h4>
    </div>
  <% else %>
    <% pivot = resource_tally_pivot(@incident) %>

    <div class="tally-container">
      <div class="tally-header">
        <div class="tally-header-actions no-print">
          <%# Both buttons open the Grover-generated PDF (landscape,
              auto-scaled to fit). window.print() can't reliably force
              landscape in Chrome — the injected @page rule is only a
              suggestion and the print dialog defaults to portrait —
              so we route the Print button through the PDF viewer too,
              where the PDF's baked-in orientation is respected. %>
          <%= link_to 'Download PDF',
                      tally_to_pdf_incident_resources_path(@incident, format: :pdf),
                      class: 'btn btn-primary btn-xs', target: :_blank %>
          <%= link_to 'Print',
                      tally_to_pdf_incident_resources_path(@incident, format: :pdf),
                      class: 'btn btn-default btn-xs tally-print-link',
                      target: :_blank,
                      title: "Opens the PDF in a new tab — hit Cmd/Ctrl+P from there." %>
        </div>
        <h2>RESOURCE TALLY</h2>
        <p class="muted">Live counts — updates automatically as resources check in or demob.</p>
      </div>

      <% if pivot[:agencies].empty? %>
        <p class="muted"><em>No assigned resources with a recognizable agency.</em></p>
      <% else %>
        <div class="tally-table-wrap">
          <table class="tally-table">
            <thead>
              <tr>
                <th class="tally-agency-col">Agency or Organization</th>
                <th class="tally-count-col"></th>
                <% pivot[:columns].each do |col| %>
                  <th class="tally-col-header <%= 'is-overhead' if col[:overhead] %> <%= 'is-total' if col[:total] %>">
                    <div class="tally-col-label"><%= col[:label] %></div>
                  </th>
                <% end %>
              </tr>
            </thead>
            <tbody>
              <% pivot[:agencies].each_with_index do |agency, idx| %>
                <% cells = pivot[:rows][agency] %>
                <tr class="tally-agency-row <%= 'is-even' if idx.even? %>">
                  <td class="tally-agency-cell" rowspan="2"><%= agency %></td>
                  <td class="tally-count-label">resources</td>
                  <% pivot[:columns].each do |col| %>
                    <% cell = cells[col[:key]] %>
                    <td class="tally-cell <%= 'is-overhead' if col[:overhead] %> <%= 'is-total' if col[:total] %>">
                      <% unless col[:overhead] || col[:total] %>
                        <%= cell[:resources].positive? ? cell[:resources] : '' %>
                      <% end %>
                    </td>
                  <% end %>
                </tr>
                <tr class="tally-agency-row <%= 'is-even' if idx.even? %>">
                  <td class="tally-count-label">personnel</td>
                  <% pivot[:columns].each do |col| %>
                    <% cell = cells[col[:key]] %>
                    <td class="tally-cell <%= 'is-overhead' if col[:overhead] %> <%= 'is-total' if col[:total] %>">
                      <%= cell[:personnel].positive? ? cell[:personnel] : '' %>
                    </td>
                  <% end %>
                </tr>
              <% end %>

              <%# Total row — matches the ICS form footer. %>
              <tr class="tally-total-row">
                <td class="tally-agency-cell tally-total-label" rowspan="2">Total</td>
                <td class="tally-count-label">resources</td>
                <% pivot[:columns].each do |col| %>
                  <% t = pivot[:totals][col[:key]] %>
                  <td class="tally-cell <%= 'is-overhead' if col[:overhead] %> <%= 'is-total' if col[:total] %>">
                    <% unless col[:overhead] || col[:total] %>
                      <%= t[:resources].positive? ? t[:resources] : '' %>
                    <% end %>
                  </td>
                <% end %>
              </tr>
              <tr class="tally-total-row">
                <td class="tally-count-label">personnel</td>
                <% pivot[:columns].each do |col| %>
                  <% t = pivot[:totals][col[:key]] %>
                  <td class="tally-cell <%= 'is-overhead' if col[:overhead] %> <%= 'is-total' if col[:total] %>">
                    <%= t[:personnel].positive? ? t[:personnel] : '' %>
                  </td>
                <% end %>
              </tr>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  <% end %>
  <div class="panel-foot"></div>
</div>
