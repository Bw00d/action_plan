<%= content_for :title, "Meeting Schedule" %>

<div class="schedule-page">
  <div class="incident-name">
    <h1><%= link_to @incident.display_incident_name, @incident %></h1>
  </div>

  <% if @schedule.errors.any? %>
    <div class="alert alert-danger">
      <strong>Could not add meeting:</strong>
      <ul>
        <% @schedule.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="schedule-panels">
    <%= render 'schedule_panel',
               title:     'Meeting Schedule',
               schedules: @meeting_schedules,
               scope:     'meeting' %>

    <% if current_user %>
      <%= render 'schedule_panel',
                 title:     'My Schedule',
                 schedules: @my_schedules,
                 scope:     'my' %>
    <% end %>
  </div>

  <script>
    document.addEventListener('turbolinks:load', function () {
      // Each panel's select-all is scoped by data-scope so toggling one
      // doesn't affect the other panel's rows.
      document.querySelectorAll('.schedule-check-all').forEach(function (master) {
        master.addEventListener('change', function () {
          var scope = master.dataset.scope;
          document.querySelectorAll('.schedule-check[data-scope="' + scope + '"]')
            .forEach(function (cb) { cb.checked = master.checked; });
        });
      });

      // Per-panel print. Set a scope class on body so the @media print
      // rules can hide the sibling panel for the duration of the dialog.
      document.querySelectorAll('.schedule-print-btn').forEach(function (btn) {
        btn.addEventListener('click', function () { printSchedule(btn.dataset.scope); });
      });
    });

    function printSchedule(scope) {
      var body = document.body;
      // Hide any unchecked rows (within the panel we're actually printing).
      document.querySelectorAll('.schedule-check[data-scope="' + scope + '"]').forEach(function (cb) {
        var row = document.getElementById(cb.dataset.row);
        if (row) row.classList.toggle('is-print-hidden', !cb.checked);
      });

      body.classList.add('printing-schedule', 'printing-scope-' + scope);
      var style = document.createElement('style');
      style.id = 'print-orientation';
      style.textContent = '@page { size: portrait; margin: 0.5in; }';
      document.head.appendChild(style);

      var cleanup = function () {
        body.classList.remove('printing-schedule', 'printing-scope-' + scope);
        var s = document.getElementById('print-orientation');
        if (s) s.remove();
        document.querySelectorAll('tr.is-print-hidden').forEach(function (r) {
          r.classList.remove('is-print-hidden');
        });
        window.removeEventListener('afterprint', cleanup);
      };
      window.addEventListener('afterprint', cleanup);
      window.print();
    }
  </script>
</div>
