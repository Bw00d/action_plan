<style>
  @page { size: Letter landscape; margin: 0.4in; }
  html, body { margin: 0; padding: 0; font-family: Arial, Helvetica, sans-serif; color: #000; }
  h1 { font-size: 16pt; margin: 0 0 4pt; }
  h2 { font-size: 12pt; margin: 12pt 0 4pt; padding-bottom: 2pt; border-bottom: 1px solid #999; }
  .ops-pdf-meta { font-size: 10pt; margin-bottom: 8pt; color: #333; }
  .ops-pdf-meta span { margin-right: 14pt; }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 10pt;
    page-break-inside: avoid;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  th, td { border: 0.75pt solid #666; padding: 3pt 5pt; text-align: center; vertical-align: middle; }
  thead th { background: #ececec; font-weight: 600; }
  .kind { text-align: left; background: #f7f7f7; font-weight: 500; width: 22%; }
  .day  { background: #dcdcdc; }
  .have { background: #f4f9ff; }
  .req  { background: #fff6e6; }
  .need { font-weight: 600; }
  .empty { color: #666; font-style: italic; padding: 8pt; }
  tfoot td { background: #f0f0f0; font-weight: 600; }
</style>

<h1><%= @incident.display_incident_name %> — <%= @tab == 'ics_215' ? 'ICS-215 Operational Planning Worksheet' : 'Projections' %></h1>
<div class="ops-pdf-meta">
  <span><strong>Selection:</strong> <%= @selected_org_unit.kind.titleize %>: <%= @selected_org_unit.name %></span>
  <span><strong>Days:</strong> <%= @days.map { |d| d.strftime('%a %-m/%-d') }.join(' · ') %></span>
  <span><strong>Printed:</strong> <%= Time.current.strftime('%Y-%m-%d %H:%M') %></span>
</div>

<% @sections.each do |section| %>
  <h2><%= section[:unit].kind.titleize %>: <%= section[:unit].name %></h2>

  <% if @tab == 'ics_215' %>
    <table>
      <thead>
        <tr>
          <th rowspan="2" class="kind">Kind / Type</th>
          <% @days.each do |day| %>
            <th colspan="3" class="day"><%= day.strftime('%a %-m/%-d') %></th>
          <% end %>
        </tr>
        <tr>
          <% @days.count.times do %>
            <th>Have</th><th>Req</th><th>Need</th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% if section[:rows].empty? %>
          <tr><td colspan="<%= 1 + @days.count * 3 %>" class="empty">
            No resources currently assigned to <%= section[:unit].name %>.
          </td></tr>
        <% else %>
          <% section[:rows].each do |row| %>
            <tr>
              <td class="kind"><%= row[:position] %></td>
              <% row[:days].each do |cell| %>
                <td class="have"><%= cell[:have] %></td>
                <td class="req"><%= cell[:req] %></td>
                <td class="need"><%= cell[:need].nil? || cell[:need].zero? ? '' : cell[:need] %></td>
              <% end %>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <table>
      <thead>
        <tr>
          <th class="kind">Kind / Type</th>
          <% @days.each do |day| %>
            <th class="day"><%= day.strftime('%a %-m/%-d') %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% if section[:rows].empty? %>
          <tr><td colspan="<%= 1 + @days.count %>" class="empty">
            No resources currently assigned to <%= section[:unit].name %>.
          </td></tr>
        <% else %>
          <% section[:rows].each do |row| %>
            <tr>
              <td class="kind"><%= row[:position] %></td>
              <% row[:days].each do |cell| %>
                <td><%= cell[:count] %></td>
              <% end %>
            </tr>
          <% end %>
        <% end %>
      </tbody>
      <% if section[:rows].any? %>
        <tfoot>
          <tr>
            <td class="kind">Total Personnel</td>
            <% section[:day_personnel].each do |cell| %>
              <td><%= cell[:total] %></td>
            <% end %>
          </tr>
        </tfoot>
      <% end %>
    </table>
  <% end %>
<% end %>
