<%= content_for :title, @user.full_name %>
<% status = @user.directory_status %>
<div class="container dir-page">
  <p><%= link_to '← Directory', directory_index_path %></p>

  <div class="dir-card dir-profile">
    <div class="dir-profile-head">
      <%= directory_avatar(@user, size: :lg) %>
      <div class="dir-profile-id">
        <h1><%= @user.full_name %></h1>
        <p class="dir-profile-sub">
          <%= [unit_and_dispatch(@user, labels: true).presence, friendly_time_zone(@user.time_zone)].compact.join(' · ') %>
        </p>
      </div>

      <%# Buttons render only for what this person chose to share. Each one
          reveals the numbers or addresses below instead of opening an app
          (see directory.js). %>
      <% contact_groups = { 'phone' => @shared_phones, 'email' => @shared_emails }.reject { |_, list| list.empty? } %>
      <% if contact_groups.any? %>
        <div class="dir-contact">
          <% contact_groups.each_key do |kind| %>
            <button type="button" class="btn btn-default dir-contact-btn" aria-expanded="false"
                    aria-controls="dir-contact-<%= kind %>" data-contact-toggle="<%= kind %>">
              <i class="fa <%= kind == 'phone' ? 'fa-phone' : 'fa-envelope-o' %>" aria-hidden="true"></i>
              <%= kind == 'phone' ? 'Phone' : 'Email' %>
            </button>
          <% end %>
        </div>
      <% end %>
    </div>

    <% contact_groups.each do |kind, list| %>
      <ul class="dir-contact-panel" id="dir-contact-<%= kind %>" hidden>
        <% list.each do |c| %>
          <li>
            <span class="dir-contact-label"><%= c.label.presence || kind.capitalize %></span>
            <span class="dir-contact-value"><%= c.value %></span>
          </li>
        <% end %>
      </ul>
    <% end %>

    <div class="dir-status-cards">
      <div class="dir-stat">
        <div class="dir-stat-label">Status</div>
        <div class="dir-stat-value dir-stat-value--<%= status %>"><%= DirectoryHelper::STATUS_LABELS.fetch(status) %></div>
      </div>
      <div class="dir-stat">
        <div class="dir-stat-label">Current incident</div>
        <div class="dir-stat-value">
          <% if @current_assignment %>
            <%= @current_assignment.incident.name %><%= ", #{@current_assignment.incident.state}" if @current_assignment.incident.state.present? %>
          <% else %>
            <span class="text-muted">—</span>
          <% end %>
        </div>
      </div>
      <div class="dir-stat">
        <div class="dir-stat-label">Available after</div>
        <div class="dir-stat-value">
          <%= @user.available_after ? @user.available_after.strftime('%b %-d') : content_tag(:span, '—', class: 'text-muted') %>
        </div>
      </div>
    </div>

    <h2 class="dir-section-title">Qualifications</h2>
    <% if @qualifications.empty? %>
      <p class="text-muted">No qualifications listed.</p>
    <% else %>
      <ul class="dir-quals">
        <% @qualifications.each do |q| %>
          <li class="dir-qual-row">
            <span class="dir-qual-name"><%= q.position.label %></span>
            <span class="dir-qual-status dir-qual-status--<%= q.status %>"><%= q.status_label %></span>
          </li>
        <% end %>
      </ul>
    <% end %>

    <h2 class="dir-section-title">Recent assignments</h2>
    <% if @recent_assignments.empty? %>
      <p class="text-muted">No assignments recorded in Action Plan yet.</p>
    <% else %>
      <ul class="dir-assignments">
        <% @recent_assignments.each do |r| %>
          <li>
            <%= r.incident.name %><%= ", #{r.incident.state}" if r.incident.state.present? %>
            · <%= r.position %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if @emergency_contact %>
      <div class="dir-emergency">
        <strong><i class="fa fa-lock" aria-hidden="true"></i> Emergency contact (admins only)</strong>
        <% if @emergency_contact.values.all?(&:blank?) %>
          <p class="text-muted">None on file.</p>
        <% else %>
          <p>
            <%= @emergency_contact[:name] %>
            <%= "(#{@emergency_contact[:relation]})" if @emergency_contact[:relation].present? %>
            <% if @emergency_contact[:phone].present? %>
              · <%= link_to @emergency_contact[:phone], "tel:#{@emergency_contact[:phone].gsub(/[^\d+]/, '')}" %>
            <% end %>
          </p>
        <% end %>
      </div>
    <% else %>
      <p class="dir-footnote"><i class="fa fa-lock" aria-hidden="true"></i> Emergency contact visible to admins only</p>
    <% end %>

    <% if policy_for(@user).update? %>
      <div class="dir-profile-actions">
        <%= link_to 'Edit my profile', edit_profile_path, class: 'btn btn-default btn-sm' %>
      </div>
    <% end %>
  </div>
</div>
