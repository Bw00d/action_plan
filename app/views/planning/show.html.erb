<% content_for :title, "Plans" %>

<div class="planning-page">
  <div class="incident-name">
    <h1><%= link_to @incident.display_incident_name, @incident %></h1>
  </div>

  <h2 class="planning-title">Planning Tools</h2>

  <section class="planning-tool">
    <h3>Reconcile IROC</h3>
    <p class="muted">
      Upload a CSV of resources from IROC. We'll compare the "At Incident"
      rows (Aircraft, Crews, Equipment, Overhead) against what's checked
      in here and list anyone IROC says is on the fire but isn't in our
      records yet.
    </p>

    <%= form_with url: reconcile_iroc_incident_planning_path(@incident),
                  method: :post,
                  multipart: true,
                  local: true,
                  html: { class: 'planning-tool-form' } do |f| %>
      <%= file_field_tag :iroc_csv, accept: '.csv', required: true, class: 'form-control-file' %>
      <%= f.submit 'Reconcile', class: 'btn btn-primary' %>
    <% end %>

    <% if @result %>
      <div class="planning-result">
        <h4>Reconciliation Results</h4>
        <ul class="planning-summary muted">
          <li><strong><%= @result.matched_count %></strong> matched — in IROC and here</li>
          <li><strong><%= @result.missing.size %></strong> on IROC but not here</li>
          <% if @result.skipped_bad_prefix.positive? %>
            <li><%= @result.skipped_bad_prefix %> row<%= 's' unless @result.skipped_bad_prefix == 1 %> skipped (not A/C/E/O)</li>
          <% end %>
        </ul>

        <% if @result.missing.any? %>
          <h5>Missing from this incident (on IROC, not checked in here)</h5>
          <table class="table planning-missing-table">
            <thead>
              <tr>
                <th>Request #</th>
                <th>Category</th>
                <th>Name</th>
                <th>Agency</th>
                <th>Kind</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% @result.missing.each do |row| %>
                <% has_kids = row.children.any? %>
                <tr class="<%= 'planning-missing-row--demobbed' if row.released_on %> <%= 'planning-missing-row--parent' if has_kids %>"
                    <%= "data-group-id=\"grp-#{row.request}\"".html_safe if has_kids %>>
                  <td class="col-order">
                    <% if has_kids %>
                      <%# Expand/collapse carat for missing parents with
                          nested missing subordinates. Hidden by default
                          so the user isn't buried in 14 sub rows per
                          crew. %>
                      <button type="button" class="planning-missing-toggle"
                              data-group-target="grp-<%= row.request %>"
                              aria-expanded="false"
                              title="Show <%= row.children.size %> subordinate<%= 's' unless row.children.size == 1 %>">
                        ▸
                      </button>
                    <% end %>
                    <%= row.request %>
                    <% if has_kids %>
                      <span class="planning-child-count">+<%= row.children.size %> sub<%= 's' unless row.children.size == 1 %></span>
                    <% end %>
                  </td>
                  <td><%= row.category %></td>
                  <td><%= row.name %></td>
                  <td><%= row.agency %></td>
                  <td><%= row.kind %></td>
                  <td>
                    <% if row.released_on %>
                      <span class="planning-demob-tag">
                        Demobilized — <%= row.released_on.strftime('%m/%d/%y') %>
                      </span>
                    <% else %>
                      <span class="muted">Not on incident</span>
                    <% end %>
                  </td>
                </tr>
                <% row.children.each do |child| %>
                  <tr class="planning-missing-row--child <%= 'planning-missing-row--demobbed' if child.released_on %>"
                      data-group-child="grp-<%= row.request %>"
                      style="display:none;">
                    <td class="col-order planning-missing-row--child-indent"><%= child.request %></td>
                    <td><%= child.category %></td>
                    <td><%= child.name %></td>
                    <td><%= child.agency %></td>
                    <td><%= child.kind %></td>
                    <td>
                      <% if child.released_on %>
                        <span class="planning-demob-tag">
                          Demobilized — <%= child.released_on.strftime('%m/%d/%y') %>
                        </span>
                      <% else %>
                        <span class="muted">Not on incident</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="text-success"><strong>Everything matches.</strong> Nothing on IROC is missing from this incident.</p>
        <% end %>
      </div>
    <% end %>
  </section>

  <section class="planning-tool">
    <h3>Crew Swaps Log</h3>
    <p class="muted">
      Spreadsheet view of every scheduled + completed crew swap on this
      incident — one row per swap, so you can review turnover across
      the length of the fire.
    </p>
    <%= link_to 'Open crew swaps log →',
                crew_swaps_incident_planning_path(@incident),
                class: 'btn btn-primary' %>
  </section>
</div>

<script>
  // Collapse/expand the hidden child rows under a missing parent in
  // the IROC reconcile table. Carat flips between ▸ (closed) and ▾
  // (open) so the state is obvious.
  (function () {
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('.planning-missing-toggle');
      if (!btn) return;
      var groupId = btn.getAttribute('data-group-target');
      var open    = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', open ? 'false' : 'true');
      btn.textContent = open ? '▸' : '▾';
      document.querySelectorAll('[data-group-child="' + groupId + '"]').forEach(function (row) {
        row.style.display = open ? 'none' : '';
      });
    });
  })();
</script>
