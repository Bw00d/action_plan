<%= content_for :title, 'Request Access' %>
<div class="col-md-4 center-block">
  <div class="panel panel-default devise-bs">
    <div class="panel-heading">
      <h4>Request access</h4>
    </div>
    <div class="panel-body">
      <p class="text-muted">
        Action Plan accounts are set up by an administrator. Tell us who you
        are, and you'll get an email to set your password once you're approved.
      </p>

      <%= form_with model: @access_request, local: true, html: { role: 'form' } do |f| %>
        <% if @access_request.errors.any? %>
          <div class="alert alert-danger">
            <ul>
              <% @access_request.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
            </ul>
          </div>
        <% end %>

        <div class="form-group required">
          <%= f.label :first_name, 'First name' %>
          <%= f.text_field :first_name, class: 'form-control', required: true, autofocus: true %>
        </div>

        <div class="form-group required">
          <%= f.label :last_name, 'Last name' %>
          <%= f.text_field :last_name, class: 'form-control', required: true %>
        </div>

        <div class="form-group required">
          <%= f.label :email %>
          <%= f.email_field :email, class: 'form-control', required: true %>
        </div>

        <div class="form-group required">
          <%= f.label :position, 'ICS function or position' %>
          <%= f.text_field :position, class: 'form-control', required: true,
                           placeholder: 'e.g. Planning Section Chief, RESL, Dispatch' %>
        </div>

        <%# Honeypot: hidden from people, filled in by bots. See
            AccessRequestsController::HONEYPOT_FIELD. %>
        <div style="position:absolute;left:-10000px;" aria-hidden="true">
          <label for="website">Website</label>
          <input type="text" name="website" id="website" tabindex="-1" autocomplete="off">
        </div>

        <%= f.submit 'Request access', class: 'btn btn-primary' %>
      <% end %>
    </div>
  </div>
  <%= link_to 'Already have an account? Sign in', new_user_session_path %>
</div>
