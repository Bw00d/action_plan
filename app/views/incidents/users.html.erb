<%= content_for :title, "#{@incident.name} — Collaborators & Feed" %>

<div class="incident-users-page">
  <header class="iup-page-head">
    <h1><%= link_to @incident.display_incident_name, @incident %></h1>
    <%= link_to '← Back to incidents', incidents_path, class: 'iup-back' %>
  </header>

  <%# ── Collaborators card ─────────────────────────────────── %>
  <section class="iup-card">
    <div class="iup-card-head">
      <h2>
        Collaborators
        <span class="iup-count-badge"><%= @users.count %></span>
      </h2>
      <p class="iup-card-sub">People who can view and edit this incident.</p>
    </div>

    <div class="iup-card-body">
      <%= form_tag invite_incidents_path, method: :post, class: 'iup-invite-form' do %>
        <%= hidden_field_tag :incident_id, @incident.id %>
        <%= text_field_tag :invite, params[:invite],
                           placeholder: 'Invite by email…',
                           class: 'form-control iup-invite-input',
                           autocomplete: 'off' %>
        <%= submit_tag 'Invite', class: 'btn btn-primary btn-sm iup-invite-btn' %>
      <% end %>

      <ul class="iup-collab-list">
        <%# Owner always first, no remove control. %>
        <li class="iup-collab-row is-owner">
          <span class="iup-avatar"><%= user_initials(@incident.owner) %></span>
          <div class="iup-collab-meta">
            <div class="iup-collab-name"><%= @incident.owner.full_name %></div>
            <div class="iup-collab-email"><%= @incident.owner.email %></div>
          </div>
          <span class="iup-role-badge iup-role-owner">Owner</span>
        </li>

        <% @users.each do |u| %>
          <% next if u == @incident.owner %>
          <li class="iup-collab-row">
            <span class="iup-avatar"><%= user_initials(u) %></span>
            <div class="iup-collab-meta">
              <div class="iup-collab-name"><%= u.full_name %></div>
              <div class="iup-collab-email"><%= u.email %></div>
            </div>
            <%= form_tag incidents_remove_user_path, method: :post, class: 'iup-remove-form',
                         data: { confirm: "Remove #{u.full_name} from this incident?" } do %>
              <%= hidden_field_tag :incident_id, @incident.id %>
              <%= hidden_field_tag :user, u.id %>
              <button type="submit" class="iup-remove-btn" title="Remove collaborator">
                <i class="fa fa-times"></i>
              </button>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </section>

  <%# ── Feed card ─────────────────────────────────────────── %>
  <section class="iup-card">
    <div class="iup-card-head">
      <h2>Feed</h2>
      <p class="iup-card-sub">Post updates and coordinate with collaborators. System events (plan changes, invites) also appear here.</p>
    </div>

    <div class="iup-card-body">
      <%= render 'incident_posts/feed',
                 incident: @incident,
                 posts: @top_posts,
                 events: @events %>

      <div id="feed-composer-anchor">
        <%= render 'incident_posts/composer',
                   incident: @incident,
                   new_post: @new_post,
                   parent: nil %>
      </div>
    </div>
  </section>
</div>
