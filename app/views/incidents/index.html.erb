<%= content_for :title, "Incidents" %>
<div class="container">
  <div class="row">
    <div class="col-lg-8 col-xs-12 center-block">

      <h1><strong>Incidents</strong></h1>

      <% if @current_year_incidents.empty? && @prior_incidents_by_year.empty? %>
        <h3>Begin by adding an incident.</h3>
      <% end %>

      <% if @current_year_incidents.any? %>
        <h3 class="incident-year-heading"><%= Date.current.year %></h3>
        <% @current_year_incidents.each do |incident| %>
          <%= render 'incident_card', incident: incident %>
        <% end %>
      <% elsif @prior_incidents_by_year.any? %>
        <p class="text-muted">No incidents this year yet.</p>
      <% end %>

      <% if @prior_incidents_by_year.any? %>
        <details class="prior-incidents">
          <summary>
            Previous years
            <span class="text-muted">(<%= @prior_incident_count %> incident<%= @prior_incident_count == 1 ? '' : 's' %>)</span>
          </summary>
          <% @prior_incidents_by_year.each do |year, incidents| %>
            <h3 class="incident-year-heading"><%= year %></h3>
            <% incidents.each do |incident| %>
              <%= render 'incident_card', incident: incident %>
            <% end %>
          <% end %>
        </details>
      <% end %>

      <br>
      <%= link_to 'New Incident', new_incident_path, class: 'btn btn-success tiny' %>
    </div>
  </div>
</div>
