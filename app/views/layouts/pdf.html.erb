<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%= stylesheet_link_tag 'application', media: 'all' %>
    <style>
      /* PDF-specific overrides and essential styles */
      @page {
        size: letter;
        margin: 0.4in !important;
      }
      html, body { margin: 0 !important; padding: 0 !important; }
      .page-wrapper { min-height: 100vh; }

      /* 203: force the org chart to fill the printable width — Bootstrap's
         .col-lg-8 would otherwise clamp it to 66% and center it. The 202
         no longer uses this Bootstrap grid (it renders inside .ics-form-sheet
         with its own self-contained print styles in plans.css.scss), so
         these rules are 203-only now. */
      #organization-assignments > .container,
      #organization-assignments > .container > .col-xs-12.col-lg-8.center-block {
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        float: none !important;
      }
      /* Bootstrap .row has margin-left/right: -15px, which normally cancels
         col padding. With outer col padding zeroed out above, those negative
         margins push cell borders past the @page margin and clip content.
         Also zero the col padding inside the chart so nothing overshoots. */
      #organization-assignments .row {
        margin-left: 0 !important;
        margin-right: 0 !important;
      }
      #organization-assignments .col-xs-6,
      #organization-assignments .col-xs-12 {
        padding-left: 0 !important;
        padding-right: 0 !important;
      }

      /* 203-only row-height for content-box cells. min-height keeps blank
         rows compact; when a name cell wraps to a second line the row
         grows to fit rather than clipping. */
      #organization-assignments {
        --row-height: 22px;
      }
      #organization-assignments .content-box {
        min-height: var(--row-height) !important;
        height: auto !important;
        padding: 3px 5px !important;
        font-size: 11px !important;
        word-wrap: break-word !important;
        overflow-wrap: break-word !important;
        white-space: normal !important;
      }
      /* Pair each row's two cells so the position cell grows with a
         wrapped name cell — flex + align-items:stretch on the row itself. */
      #organization-assignments .staff-row,
      #organization-assignments .blank-row,
      #organization-assignments .left-column > .row,
      #organization-assignments .right-column > .row {
        display: flex !important;
        align-items: stretch !important;
      }
      #organization-assignments .staff-row > .content-box,
      #organization-assignments .blank-row > .content-box,
      #organization-assignments .left-column > .row > .content-box,
      #organization-assignments .right-column > .row > .content-box {
        float: none !important;
      }
      /* Column pad rows are real DOM rows (see the ERB); nothing extra
         needed to make them render — they inherit .content-box borders. */
      html, body, .page-wrapper,
      #organization-assignments {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
      #organization-assignments .header-row {
        padding-top: 2px !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
      #organization-assignments #title-box h4 {
        font-size: 10px !important;
        line-height: 1 !important;
        white-space: nowrap !important;
        margin: 0 !important;
      }
      #organization-assignments .top-row {
        height: 26px !important;
      }

      /* 203 header (title + Incident Name + Op Period + Dates).
         .content-box's !important height/padding above would otherwise
         crush the flex-column layout inside .org-header-cell and pin the
         label bar's border-bottom in the wrong place. */
      #organization-assignments .org-header .org-header-cell {
        padding: 0 !important;
        height: auto !important;
        min-height: 44px !important;
      }
      #organization-assignments .org-header .org-header-cell.org-header-tall {
        min-height: 74px !important;
      }
      #organization-assignments .org-header .org-header-label {
        height: 22px !important;
        padding: 3px 5px !important;
        font-size: 11px !important;
      }
      /* Left "1. Incident Name:" label grows to 30px so its bottom border
         lines up with the "2. Operational Period:" cell's bottom border on
         the right — both sides of the header share a horizontal line at
         30px from the top. Matches the on-screen behavior triggered by
         adding .content-box to the label div. */
      #organization-assignments .org-header .org-header-cell.org-header-tall > .org-header-label {
        height: 30px !important;
        min-height: 30px !important;
      }
      #organization-assignments .org-header .org-header-value {
        padding: 3px 5px !important;
        font-size: 11px !important;
      }
      #organization-assignments .org-header .op-period-cell {
        padding: 3px 5px !important;
        font-size: 11px !important;
      }

      /* Mirror the on-screen fix: outer header row is a flex container so
         left (Incident Name, tall) and right (Op Period + Dates) always
         match the tallest sibling. Without this the right stack pushed
         past its target height and the left column ended short. */
      #organization-assignments .row.org-header {
        display: flex !important;
        align-items: stretch !important;
      }
      #organization-assignments .row.org-header > [class^="col-"] {
        float: none !important;
      }
      #organization-assignments .row.org-header > .org-header-right {
        display: flex !important;
        flex-direction: column !important;
      }
      #organization-assignments .row.org-header > .org-header-right > .row:first-child {
        flex: 0 0 30px !important;
        display: flex !important;
      }
      #organization-assignments .row.org-header > .org-header-right > .row:first-child > .op-period-cell {
        flex: 1 1 auto !important;
      }
      #organization-assignments .row.org-header > .org-header-right > .row:last-child  {
        flex: 1 1 auto !important;
        display: flex !important;
      }
      #organization-assignments .row.org-header > .org-header-right > .row:last-child > .org-header-cell {
        flex: 1 1 50% !important;
      }

      /* 203 footer rows compact to match --row-height. */
      #organization-assignments .org-footer .content-box {
        height: 22px !important;
        min-height: 22px !important;
        padding: 3px 5px !important;
        font-size: 11px !important;
      }
      #organization-assignments .org-footer-meta {
        font-size: 10px !important;
        padding: 2px 4px 0 !important;
      }

      #organization-assignments .print-button { display: none !important; }
      
      
      /* Hide elements that shouldn't appear in PDFs */
      .no-print,
      .resources-button,
      .header-button,
      .new-freq-button,
      #header,
      nav,
      .footer:not(.ics-204-wf-page .footer) {
        display: none !important;
      }

      /* ---------- ICS 204 WF PDF pagination ---------- */
      /* Server-side page splitting: each .wf-page is a complete
         self-contained page (sections 1-4 header, middle content,
         sections 8-9 footer). page-break-after: always forces the
         browser to start a new physical page after every block; the
         last block naturally ends without a trailing blank page. */

      @page {
        size: letter;
        margin: 0.25in 0.4in;
      }

      .ics-204-wf-pdf {
        padding: 0 !important;
        margin: 0 !important;
        box-shadow: none !important;
      }

      .ics-204-wf-pdf .wf-page {
        page-break-after: always;
        break-after: page;
        /* Printable area is 10.15in with Grover margins 0.25in top /
           0.6in bottom (bottom was widened to give Grover's PDF-level
           footer bar room to render without edge clipping — see
           AssignmentsController). Undershoot by ~0.25in to absorb
           puppeteer rounding and keep sections 8-9 pinned cleanly to
           the block's bottom edge. */
        height: 9.9in;
        max-height: 9.9in;
        overflow: hidden;
        display: flex;
        flex-direction: column;
      }
      .ics-204-wf-pdf .wf-page:last-child {
        page-break-after: auto;
        break-after: auto;
        /* Last page carries box-6 (Control Operations). If the operator
           types more text than the fixed 10.2in slot can hold, the
           earlier `overflow: hidden` on .wf-page would silently clip it.
           Lifting the cap here lets long Control Operations copy flow
           onto a continuation physical page instead of being truncated.
           Earlier pages still keep the strict height so sections 8-9
           stay pinned to the bottom. */
        height: auto;
        max-height: none;
        overflow: visible;
      }

      /* Header (blocks 1-4) sits at the top of every page. */
      .ics-204-wf-pdf .wf-page-header {
        flex: 0 0 auto;
      }
      /* Middle (block 5 + optional 6/7) fills the space between the
         page-header and page-footer. On page 1, section 7 uses its
         own flex so it stretches to fill any leftover height. */
      .ics-204-wf-pdf .wf-page-middle {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
      }
      /* Footer (blocks 8-9) sits at the bottom of every page. */
      .ics-204-wf-pdf .wf-page-footer {
        flex: 0 0 auto;
      }

      /* Sections 6 & 7 wrapper: single-column flex so section 7 can
         grow. Bordered to match the target template. */
      .ics-204-wf-pdf .narrative-print {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        border-left: 1px solid #000;
        border-right: 1px solid #000;
        border-bottom: 1px solid #000;
      }
      .ics-204-wf-pdf .narrative-print .box-6,
      .ics-204-wf-pdf .narrative-print .box-7 {
        border-top: 1px solid #000;
        padding: 3pt 4pt;
        font-size: 8pt;
        vertical-align: top;
        /* The shared on-screen scope (.ics-204-wf-page .box-6) sets a
           hard `height: 1.15in`. Both classes apply to the PDF div
           (<div class="ics-204-wf-page ics-204-wf-pdf">), and `height`
           beats `min-height` for the actual box size — leaving long
           Control Ops text bleeding onto sections 7-8. Override to
           auto so content drives the box's height. */
        height: auto !important;
      }
      /* Smaller default heights so empty sections aren't big white
         voids — box-6 grows naturally with its content, and the
         last-page overflow unlock above makes sure long entries
         aren't clipped. */
      .ics-204-wf-pdf .narrative-print .box-6 { min-height: 0.4in; }
      .ics-204-wf-pdf .narrative-print .box-7 {
        flex: 1 1 auto;            /* expand to fill leftover space */
        min-height: 0.4in;
      }

      /* Keep a resource row from being split across pages mid-line. */
      .ics-204-wf-pdf .res-row { page-break-inside: avoid; }

      /* Force gray shading in PDF. Chrome strips backgrounds by default,
         and CSS custom-property fallbacks (var(--shade)) don't always
         resolve reliably inside Grover's print pipeline — set the color
         literal here alongside print-color-adjust so shaded cells (all
         .shade / .banner / .banner-num + section 8 Function column)
         render the same gray as the on-screen assignment page. */
      .ics-204-wf-pdf .shade,
      .ics-204-wf-pdf .banner,
      .ics-204-wf-pdf .banner-num,
      .ics-204-wf-pdf .comm-head .c-func,
      .ics-204-wf-pdf .comm-row  .c-func {
        background: #dcdcdc !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
      
      /* Ensure print background colors */
      @media print {
        <%# body {
          print-color-adjust: exact;
          -webkit-print-color-adjust: exact;
        } %>
      }

    </style>
  </head>
  <body>
    <div class="page-wrapper">
      <%= yield %>
    </div>
  </body>
</html>