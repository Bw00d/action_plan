<% content_for :navigation_menu do %>
  <%= render 'layouts/base_menu_items' %>
<% end %>

<% content_for :admin_menu do %>
  <%# Menu items that that should only appear in the navbar of users with
  "admin" role, grouped under one dropdown. The pending access-request
  count also shows on the toggle so it's visible while the menu is closed. %>
  <% pending = AccessRequest.pending.count %>
  <li class="dropdown">
    <a href="#" class="dropdown-toggle nav-feed-link" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
      <%= t('navigation.admin') %> <span class="caret"></span>
      <% if pending.positive? %><span class="feed-badge"><%= pending %></span><% end %>
    </a>
    <ul class="dropdown-menu">
      <li><%= link_to t('navigation.users'), admin_users_path %></li>
      <li>
        <%= link_to admin_access_requests_path do %>
          <%= t('navigation.access-requests') %>
          <% if pending.positive? %><span class="badge"><%= pending %></span><% end %>
        <% end %>
      </li>
      <% if @incident&.persisted? %>
        <li><%= link_to "Chat", admin_incident_chat_path(@incident), title: "Admin chat scoped to this incident" %></li>
      <% end %>
    </ul>
  </li>
<% end %>

<%# Render the base layout (application.html.erb), to which this layout will
pass the menu items. :admin_menu is yielded separately so it sits after
the incident Feed link. %>
<%= render template: "layouts/application" %>
