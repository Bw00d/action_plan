<%# Menu items that that should appear in the navbar of all logged-in users,
regardless of their roles %>

<% if @incident %>
  <% unless request.path == 'plans/new' || request.path == '/incidents/new' %>
  <% unless @incident.plans.empty? %>
    <li><%= link_to "IAP", incident_plan_path(@incident, @incident.plans.last) %></li>
  <% else %>
  <li><%= link_to "IAP", new_incident_plan_path(@incident) %></li>
  <% end %>
    <li><%= link_to "Resources", incident_resources_path(@incident) %></li>
    <li><%= link_to "Ops", incident_ops_path(@incident) %></li>
    <li><%= link_to "Plans", incident_planning_path(@incident) %></li>
    <li><%= link_to "Requests", incident_requests_path(@incident) %></li>
    <li><%= link_to "T Cards", incident_board_path(@incident) %></li>
    <li><%= link_to "Schedule", incident_schedules_path(@incident) %></li>
    <li><%= link_to "Demobs", incident_demob_notifications_path(@incident) %></li>
    <li><%= link_to "Check Ins", incident_remote_checkins_path(@incident),
                    title: "Review self-reported check-ins submitted via the public link" %></li>
    <% if current_user&.admin? %>
      <li><%= link_to "Chat", admin_incident_chat_path(@incident), title: "Admin chat scoped to this incident" %></li>
    <% end %>
  <% end %>
<% end %>
<li><%= link_to t('navigation.incidents'), incidents_path %></li>
