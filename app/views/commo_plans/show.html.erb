<%= content_for :title, "205" %>
  <div class="container">
    <div class="col-xs-12 col-lg-10 center-block">


      <div class="row">
        <div class="plan-panel-head">
          <ul class="tabrow">
            <li><%= link_to 'Plan', incident_plan_path(@incident, @plan) %></li>
            <li><%= link_to "Cover", incident_plan_covers_path(@incident, @plan)  %></li>
            <li><%= link_to "202", "../../#{@plan.id}/202" %></li>
            <li><%= link_to "203", "../../#{@plan.id}/203" %></li>
            <li><%= link_to "204", incident_plan_assignments_path(@incident, @plan) %></li>
            <li class="selected"><%= link_to "205", incident_plan_commo_plans_path(@incident, @plan) %></li>
            <li><%= link_to "206", '#' %></li>
            <li><%= link_to "220", '#' %></li>
            <li><%= link_to "Safety Message", incident_plan_safety_messages_path(@incident, @plan) %></li>
          </ul>
          </div>
        <div class="masking-tape"></div>
      </div>
  
<div id="commo-plan">


      <div class="row">
        <div class="tall-row top-row"> 
          <h4 class="center"><strong>INCIDENT RADIO COMMUNICATIONS PLAN(ICS 205)</strong></h4>
        </div>
        <div class="tall-row">
          <div class="col-xs-3 r-b">
            <span class=""><strong>1. Incident Name</strong></span><br>
            <span class="lg-padding-left"><%= @incident.name %></span>
          </div>
          <div class="col-xs-5 r-b"><span class=""><strong>2. Date</strong></span><br>
            <span class="lg-padding-left"></span>
            <%= best_in_place @commo_plan,  :date_prepared, :as => :input, :place_holder => "(ENTER DATE PREPARED)", class: "sm-padding-left" %>
          </div>
          <div class="col-xs-4 "><span class=""><strong>3. Operational Period:</strong></span><br>
            <%= best_in_place @commo_plan,  :ops_period, :as => :input, :place_holder => "(ENTER OPS PERIOD)", class: "sm-padding-left" %>
          </div>
        </div>
        <div class="head-spacer">
          
        </div>

        <table>
          <thead class="">
            <th class="c1"><span class="">Zone</span></th>
            <th class="c1"><span class="">Ch #</span></th>
            <th class="c-name"><span class="">Channel Name</span></th>
            <th class="c3"><span class="">Function</span></th>
            <th class="c2"><span class="">RX Freq</span></th>
            <th class="c-tone"><span class="">Tone</span></th>
            <th class="c2"><span class="">TX Freq</span></th>
            <th class="c-tone"><span class="">Tone</span></th>
            <th class="c4"><span class="">Assignment</span></th>
            <th class="c-mode"><span class="">Mode</span></th>
            <th class="c3"><span class="">Remarks</span></th>
          </thead>

          <%# All channels are pre-seeded (16 per page). Users just click
              a cell to edit inline — no need to "add" a channel row. %>
          <% @commo_plan.commo_items.each_with_index do |i, idx| %>
            <% if idx.positive? && (idx % CommoPlan::CHANNELS_PER_PAGE).zero? %>
              <%# Visual page break between logical pages so the editor
                  hints at how the PDF will split. Purely decorative. %>
              <tr class="page-break-row"><td colspan="11">Page <%= (idx / CommoPlan::CHANNELS_PER_PAGE) + 1 %></td></tr>
            <% end %>
            <tr class="radio-channel" data-item-id="<%= i.id %>">
              <td class="c1" data-field="zone"><%= best_in_place i, :zone, :as => :input %></td>
              <td class="c1" data-field="ch_num"><%= best_in_place i, :ch_num, :as => :input %></td>
              <td class="c-name" data-field="channel_name"><%= best_in_place i, :channel_name, :as => :input %></td>
              <td class="c3" data-field="function"><%= best_in_place i, :function, :as => :input %></td>
              <td class="c2" data-field="rx_freq"><%= best_in_place i, :rx_freq, :as => :input %></td>
              <td class="c-tone" data-field="rx_tone"><%= best_in_place i, :rx_tone, :as => :input %></td>
              <td class="c2" data-field="tx_freq"><%= best_in_place i, :tx_freq, :as => :input %></td>
              <td class="c-tone" data-field="tx_tone"><%= best_in_place i, :tx_tone, :as => :input %></td>
              <td class="c4" data-field="assignment"><%= best_in_place i, :assignment, :as => :input %></td>
              <td class="c-mode" data-field="mode"><%= best_in_place i, :mode, :as => :input %></td>
              <td class="c3" data-field="remarks"><%= best_in_place i, :remarks, :as => :input %></td>
            </tr>
          <% end %>
        </table>

        <div class="cp-copy-hint no-print">
          Tip: to copy a row to another row, drag-select across two or more cells in the source row — a <strong>COPY ROW</strong> chip will appear. Then hover the target row and click <strong>PASTE</strong>. <em>Zone and Ch # are not copied.</em>
        </div>

      </div>
      <div class="row">
        <div class="br bl  xs-padding-top">
          <span class=" sm-padding-left"><strong>Special Instructions</strong></span>
          <div class="special-instructions">
            <%= best_in_place @commo_plan,  :special_instructions, :as => :textarea %>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="form-row xs-padding-top bl">
          <span class=" sm-padding-left"><strong>Prepared by:</strong></span>
          <span class=" lg-padding-left">Name:</span> 
          <%= best_in_place @commo_plan,  :prepared_by, :as => :input, :place_holder => "(ENTER NAME)", class: "sm-padding-left" %>
          <span class=" huge-padding-left">Signature:</span>
        </div>
      </div>
      <div class="row">
        <div class="form-row bl bb">
          <div class="col-xs-3 r-b xs-padding-top">
            <span class=" sm-padding-left"><strong>ICS 205</strong></span>
          </div>
          <div class="col-xs-9 xs-padding-top">
            <span class=" sm-padding-left"><strong>Date/Time:</strong></span>
            <%= best_in_place @commo_plan,  :date_signed, :as => :input, :place_holder => "(ENTER DATE)", class: "sm-padding-left" %>
          </div>
        </div>
      </div> 
    </div>
     <div class="commo-plan-actions">
       <%= link_to "PRINT", "../../#{@plan.id}/commo_plans/#{@commo_plan.id}/commo_plan_to_pdf.pdf",
                   class: "btn btn-success tiny", target: :_blank %>
       <%= button_to "ADD ADDITIONAL PAGE",
                     add_page_incident_plan_commo_plan_path(@incident, @plan, @commo_plan),
                     method: :post,
                     class:  "btn btn-primary tiny",
                     form:   { class: "inline-form" } %>
       <span class="muted">
         Currently <%= @commo_plan.commo_items.count %> channels · <%= @commo_plan.page_count %> page<%= 's' unless @commo_plan.page_count == 1 %>
       </span>
     </div>
  </div>
</div>