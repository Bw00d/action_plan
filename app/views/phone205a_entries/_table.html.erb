<%#
  One phone-list sub-table matching the printed-205A row shape:
  Position | Name | Phone — no header row, just data. Cells are
  best_in_place so operators can tweak values without a round-trip
  through an edit page. Section is editable as a dropdown too; saving
  it reloads the page so the entry visibly jumps to its new card.
%>
<table class="phone-205a-table">
  <tbody>
    <% entries.each do |entry| %>
      <% path = incident_phone_205a_entry_path(incident, entry) %>
      <tr data-entry-id="<%= entry.id %>">
        <%# Drag handle — grip icon, cursor:grab. The sortable JS in
            phone_205a.js uses this cell as the drag handle so clicks
            on the data cells still activate best_in_place. %>
        <td class="col-drag" title="Drag to reorder">⠿</td>
        <td class="col-position"><%= best_in_place entry, :position, as: :input,
                                       path: path,
                                       place_holder: '(position)' %></td>
        <td class="col-name"><%=     best_in_place entry, :name,     as: :input,
                                       path: path %></td>
        <td class="col-phone"><%=    best_in_place entry, :phone_number, as: :input,
                                       path: path,
                                       place_holder: '(add later)' %></td>
        <%# Section column intentionally removed — the card header
            already shows the section name, so echoing it on every row
            was just noise. If an entry needs to move to a different
            section, delete it here and re-add it under the right
            card. %>
        <td class="col-del">
          <%= link_to '×',
                      incident_phone_205a_entry_path(incident, entry),
                      method: :delete,
                      data: { confirm: "Delete #{entry.name}?" },
                      class: 'phone-205a-del',
                      title: 'Delete' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
