<%#
  One phone-list sub-table matching the printed-215A row shape:
  Position | Name | Phone — no header row, just data. Cells are
  best_in_place so operators can tweak values without a round-trip
  through an edit page. Section is editable as a dropdown too; saving
  it reloads the page so the entry visibly jumps to its new card.
%>
<table class="phone-215a-table">
  <tbody>
    <% entries.each do |entry| %>
      <% path = incident_phone_215a_entry_path(incident, entry) %>
      <tr>
        <td class="col-position"><%= best_in_place entry, :position, as: :input,
                                       path: path,
                                       place_holder: '(position)' %></td>
        <td class="col-name"><%=     best_in_place entry, :name,     as: :input,
                                       path: path %></td>
        <td class="col-phone"><%=    best_in_place entry, :phone_number, as: :input,
                                       path: path,
                                       place_holder: '(add later)' %></td>
        <td class="col-section">
          <%# data-reload-on-save (handled in incidents.js) refreshes
              the page after a successful section change so the row
              lands under its new section card. %>
          <%= best_in_place entry, :section,
                            as: :select,
                            collection: Phone215aEntry::SECTIONS.map { |s| [s, s] },
                            path: path,
                            html_attrs: { 'data-reload-on-save' => true },
                            display_with: ->(v) { v.presence || '(section)' } %>
        </td>
        <td class="col-del">
          <%= link_to '×',
                      incident_phone_215a_entry_path(incident, entry),
                      method: :delete,
                      data: { confirm: "Delete #{entry.name}?" },
                      class: 'phone-215a-del',
                      title: 'Delete' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
