<%#
  Locals: resource (Resource), events (ordered newest-first ResourceEvents)
  Rendered inside the right-hand activity panel of the expanded T-card
  modal, and also returned raw from ResourceEventsController after any
  create/update/destroy/swap_now to re-paint the panel inline.
%>
<% if events.empty? %>
  <p class="board-card-activity-empty muted">
    No activity yet. Add a comment or schedule a crew swap above.
  </p>
<% else %>
  <ul class="board-card-activity-list">
    <% events.each do |ev| %>
      <li class="board-card-activity-item board-card-activity-item--<%= ev.kind %>"
          data-event-id="<%= ev.id %>">
        <div class="board-card-activity-meta">
          <strong><%= ev.user&.full_name.presence || ev.user&.email&.split('@')&.first || 'System' %></strong>
          <span class="muted"><%= ev.created_at.strftime('%b %-d, %-l:%M %p') %></span>
        </div>

        <% case ev.kind.to_sym %>
        <% when :comment %>
          <%# Raw body stashed on a data attr so the JS edit flow can
              populate the textarea without extracting plain text from
              simple_format's <p>/<br> output. %>
          <div class="board-card-activity-body"
               data-comment-body="<%= ev.body.to_s %>"><%= simple_format(ev.body.to_s) %></div>
          <% if ev.user_id == current_user&.id %>
            <div class="board-card-activity-actions">
              <button type="button" class="board-card-comment-edit"
                      data-url="<%= resource_event_path(resource, ev) %>"
                      title="Edit this comment">
                <i class="fa fa-pencil" aria-hidden="true"></i>
              </button>
            </div>
          <% end %>

        <% when :scheduled_swap %>
          <%# Values stashed as data attrs so the pencil button can
              repopulate the compose form without a server round-trip. %>
          <% swap_imminent = ev.fwd && ev.fwd <= Date.current + 1.day %>
          <div class="board-card-activity-tag<%= ' board-card-activity-tag--imminent' if swap_imminent %>">UPCOMING SWAP</div>
          <div class="board-card-activity-body"
               data-swap-leader="<%= ev.leader %>"
               data-swap-phone="<%= ev.phone %>"
               data-swap-fwd="<%= ev.fwd&.iso8601 %>"
               data-swap-lwd="<%= ev.lwd&.iso8601 %>"
               data-swap-body="<%= ev.body %>"
               data-swap-edit-url="<%= resource_event_path(resource, ev) %>">
            <div><strong><%= ev.leader %></strong></div>
            <div class="muted">
              FWD <%= ev.fwd&.strftime('%m/%d/%y') || '—' %>
              → LWD <%= ev.lwd&.strftime('%m/%d/%y') || '—' %>
            </div>
            <% if ev.phone.present? %>
              <div class="muted">Phone: <%= ev.phone %></div>
            <% end %>
            <% if ev.body.present? %>
              <div class="board-card-activity-note"><%= simple_format(ev.body) %></div>
            <% end %>
          </div>
          <div class="board-card-activity-actions">
            <button type="button" class="btn btn-success btn-xs board-card-swap-now"
                    data-url="<%= swap_now_resource_event_path(resource, ev) %>">
              SWAP NOW
            </button>
            <%# No data-confirm — jQuery UJS would catch it and show the
                app-styled sweetalert, but we also run our own confirm
                flow in boards.js (via sweetalert2 directly) so the
                feed can refresh after the ajax DELETE. Keeping both
                would double-prompt. The data-message attribute carries
                the confirmation text for the JS handler. %>
            <button type="button" class="btn btn-default btn-xs board-card-event-delete"
                    data-url="<%= resource_event_path(resource, ev) %>"
                    data-message="Delete this scheduled swap?">Delete</button>
            <%# Pencil — populate the swap compose form on the right with
                this swap's values and switch the form into edit mode. %>
            <button type="button" class="board-card-swap-edit"
                    title="Edit this scheduled swap">
              <i class="fa fa-pencil" aria-hidden="true"></i>
            </button>
          </div>

        <% when :completed_swap %>
          <div class="board-card-activity-tag board-card-activity-tag--past">FORMER OPERATOR</div>
          <div class="board-card-activity-body">
            <div><strong><%= ev.leader || '—' %></strong></div>
            <div class="muted">
              <%= ev.fwd&.strftime('%m/%d/%y') || '—' %>
              – <%= ev.lwd&.strftime('%m/%d/%y') || '—' %>
            </div>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
