<% content_for :title, "Board — #{@incident.display_incident_name}" %>

<div class="board-page" data-incident-id="<%= @incident.id %>">
  <header class="board-header">
    <div class="incident-name">
  <h1><%= link_to @incident.display_incident_name, @incident %></h1>
</div>
    <p class="text-muted">Drag resources between sections to assign them.</p>

    <%# Right-aligned "+ New Column" opener. Clicking the pill reveals
        the inline form; posts to the standard org_units create endpoint
        which redirects back to the board on success. Possible parents
        are limited to units that already allow children, so the server
        can only ever get a valid (kind, parent) pair. %>
    <div class="board-new-column">
      <%= link_to 'Print Roster',
                  roster_incident_board_path(@incident),
                  class: 'btn btn-default btn-sm board-print-roster',
                  target: '_blank',
                  title: 'Open a printable list of every resource grouped by column' %>

      <button type="button" class="board-new-column-toggle btn btn-primary btn-sm">
        + New Column
      </button>

      <%= form_with url: incident_org_units_path(@incident),
                    method: :post,
                    local: true,
                    html: { class: 'board-new-column-form', style: 'display:none;' } do |f| %>
        <div class="board-new-column-row">
          <%= select_tag 'org_unit[kind]',
                         options_for_select(%w[branch division group].map { |k| [k.capitalize, k] }, 'division'),
                         class: 'form-control input-sm' %>
          <%= select_tag 'org_unit[parent_id]',
                         options_from_collection_for_select(
                           @incident.org_units
                                    .where(kind: [OrgUnit.kinds[:section],
                                                  OrgUnit.kinds[:branch],
                                                  OrgUnit.kinds[:command]])
                                    .order(:kind, :name),
                           :id,
                           ->(u) { "#{u.kind.capitalize} — #{u.name}" }
                         ),
                         include_blank: 'Parent…',
                         required: true,
                         class: 'form-control input-sm' %>
          <%= text_field_tag 'org_unit[name]', nil,
                             placeholder: 'Name (e.g. Div A)',
                             required: true,
                             class: 'form-control input-sm' %>
          <%= text_field_tag 'org_unit[designator]', nil,
                             placeholder: 'Designator',
                             class: 'form-control input-sm' %>
          <%= submit_tag 'Create', class: 'btn btn-primary btn-sm' %>
          <button type="button" class="btn btn-default btn-sm board-new-column-cancel">Cancel</button>
        </div>
      <% end %>
    </div>

    <% if flash[:notice] %><div class="alert alert-success"><%= flash[:notice] %></div><% end %>
    <% if flash[:error] %><div class="alert alert-danger"><%= flash[:error] %></div><% end %>
  </header>

  <div class="board-layout">
    <div class="board-fixed">
      <%= render 'column',
                 column_id: 'unassigned',
                 org_unit_id: '',
                 title: 'Unassigned',
                 subtitle: nil,
                 resources: @unassigned_resources %>
    </div>

    <div class="board-columns">
      <% @columns.each do |unit| %>
        <%= render 'column',
                   column_id: "org-unit-#{unit.id}",
                   org_unit_id: unit.id,
                   title: unit.name,
                   subtitle: column_subtitle(unit),
                   resources: unit.resources.active.order(:position),
                   unit: unit %>
      <% end %>
    </div>
  </div>

  <div class="board-footer">
    <button type="button" class="board-add-spacer btn btn-default"
            data-url="<%= spacers_incident_board_path(@incident) %>">
      + Add blank row
    </button>
    <span class="board-footer-hint">Drop a blank row into any column to leave a gap on the ICS 204.</span>
  </div>

  <%# Shared backdrop for the Trello-style card modal. The expanded
      .board-card-details becomes a fixed-position modal (see boards.scss)
      and this overlay dims the rest of the page behind it. Toggled by
      the `is-visible` class in boards.js. %>
  <div id="board-card-overlay" aria-hidden="true"></div>
</div>

