<% content_for :title, "Board — #{@incident.display_incident_name}" %>

<div class="board-page" data-incident-id="<%= @incident.id %>">
  <header class="board-header">
    <div class="incident-name">
  <h1><%= link_to @incident.display_incident_name, @incident %></h1>
</div>
    <p class="text-muted">Drag resources between sections to assign them.</p>
    <% if flash[:notice] %><div class="alert alert-success"><%= flash[:notice] %></div><% end %>
    <% if flash[:error] %><div class="alert alert-danger"><%= flash[:error] %></div><% end %>
  </header>

  <div class="board-layout">
    <div class="board-fixed">
      <%= render 'column',
                 column_id: 'unassigned',
                 org_unit_id: '',
                 title: 'Unassigned',
                 subtitle: nil,
                 resources: @unassigned_resources %>
    </div>

    <div class="board-columns">
      <% @columns.each do |unit| %>
        <%= render 'column',
                   column_id: "org-unit-#{unit.id}",
                   org_unit_id: unit.id,
                   title: unit.name,
                   subtitle: column_subtitle(unit),
                   resources: unit.resources.active.order(:position),
                   unit: unit %>
      <% end %>
    </div>
  </div>

  <div class="board-footer">
    <button type="button" class="board-add-spacer btn btn-default"
            data-url="<%= spacers_incident_board_path(@incident) %>">
      + Add blank row
    </button>
    <span class="board-footer-hint">Drop a blank row into any column to leave a gap on the ICS 204.</span>
  </div>

  <%# Shared backdrop for the Trello-style card modal. The expanded
      .board-card-details becomes a fixed-position modal (see boards.scss)
      and this overlay dims the rest of the page behind it. Toggled by
      the `is-visible` class in boards.js. %>
  <div id="board-card-overlay" aria-hidden="true"></div>
</div>

