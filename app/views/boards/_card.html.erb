<% if resource.spacer? %>
<li class="board-card board-card--spacer" data-resource-id="<%= resource.id %>" data-personnel="0">
  <div class="board-card-strip board-card-strip--spacer">
    <span class="board-card-spacer-label">Blank row</span>
    <button type="button" class="board-card-move-toggle" title="Move to another section">
      <i class="fa fa-arrows" aria-hidden="true"></i> Move
    </button>
    <button type="button" class="board-card-delete-spacer"
            data-url="<%= spacer_incident_board_path(@incident, resource) %>"
            title="Delete blank row">&times;</button>
    <div class="board-card-move-menu" style="display:none;">
      <ul class="board-card-move-menu-list"></ul>
    </div>
  </div>
</li>
<% else %>
<li class="board-card"
    data-resource-id="<%= resource.id %>"
    data-personnel="<%= resource.effective_personnel.to_i %>"
    data-fwd="<%= resource.fwd&.iso8601 %>"
    data-assignment-length="<%= resource.assignment_length %>">
  <div class="board-card-strip" style="background: <%= resource_strip_color(resource) %>;">
    <span class="board-card-icon"><%= resource_icon_html(resource) %></span>
    <span class="board-card-agency"><%= resource.agency %></span>
    <button type="button" class="board-card-move-toggle" title="Move to another section">
      <i class="fa fa-arrows" aria-hidden="true"></i> Move
    </button>
    <div class="board-card-move-menu" style="display:none;">
      <ul class="board-card-move-menu-list"></ul>
    </div>
  </div>

  <div class="board-card-body">
    <div class="board-card-order"><%= resource.full_order_number %></div>
    <div class="board-card-name"><%= resource.name %></div>
    <div class="board-card-position"><%= resource.position %></div>

    <% lwd_class = lwd_status_class(resource) %>
    <% if lwd_class %>
      <span class="board-card-lwd <%= lwd_class %>">
        <i class="fa fa-clock-o" aria-hidden="true"></i>
        LWD <%= resource.last_work_day.strftime("%b %-d") %>
      </span>
    <% end %>
  </div>

  <%# No inline display:none — the modal visibility is driven by the
      `.board-card.is-expanded` toggle in boards.scss / boards.js. %>
  <div class="board-card-details">
    <%# Colored header strip matching the small card — same category
        color + icon + agency so the modal feels like a continuation
        of the card you double-clicked. %>
    <div class="board-card-details-header" style="background: <%= resource_strip_color(resource) %>;">
      <span class="board-card-icon"><%= resource_icon_html(resource) %></span>
      <span class="board-card-agency"><%= resource.agency %></span>
      <%# Reuses the small-card MOVE handler in boards.js — the click
          handler scopes the menu to the toggle's own parent, so this
          header's menu operates independently of the small-strip one. %>
      <button type="button" class="board-card-move-toggle" title="Move to another section">
        <i class="fa fa-arrows" aria-hidden="true"></i> Move
      </button>
      <div class="board-card-move-menu" style="display:none;">
        <ul class="board-card-move-menu-list"></ul>
      </div>
      <button type="button" class="board-card-details-close" aria-label="Close">&times;</button>
    </div>

    <%# Two-column body: left = fields + footer actions, right = activity
        feed (comments + scheduled crew swaps + completed swap history). %>
    <div class="board-card-details-body" data-events-url="<%= resource_events_path(resource) %>">
      <div class="board-card-details-main">
        <dl class="board-card-fields">
          <dt>Order #</dt>
          <dd><%= best_in_place resource, :order_number, as: :input %></dd>

          <dt>Name</dt>
          <dd class="wide"><%= best_in_place resource, :name, as: :input %></dd>

          <dt>Position</dt>
          <dd><%= best_in_place resource, :position, as: :input %></dd>

          <dt>Leader</dt>
          <dd class="wide"><%= best_in_place resource, :leader, as: :input %></dd>

          <dt>Agency</dt>
          <dd><%= best_in_place resource, :agency, as: :input %></dd>

          <dt>Personnel</dt>
          <dd><%= best_in_place resource, :number_personnel, as: :input %></dd>

          <dt>Assignment days</dt>
          <dd data-field="assignment_length"><%= best_in_place resource, :assignment_length, as: :input %></dd>

          <dt>FWD</dt>
          <dd data-field="fwd"><%= best_in_place resource, :fwd, as: :input %></dd>

          <%# LWD is derived (fwd + assignment_length - 1 day). Display-only;
              boards.js keeps it in sync whenever FWD or Assignment days
              change, without waiting for the AJAX save round-trip. %>
          <dt>LWD</dt>
          <dd data-field="lwd" class="board-card-lwd-display">
            <%= resource.last_work_day.is_a?(Date) ? resource.last_work_day.strftime('%m/%d/%y') : '' %>
          </dd>

          <dt>Release</dt>
          <dd><%= best_in_place resource, :release_date, as: :input %></dd>

          <dt>Phone</dt>
          <dd><%= best_in_place resource, :phone, as: :input %></dd>

          <dt>Email</dt>
          <dd><%= best_in_place resource, :email, as: :input %></dd>
        </dl>
      </div>

      <aside class="board-card-details-side" data-resource-id="<%= resource.id %>">
        <h4 class="board-card-side-title">Comments &amp; Activity</h4>

        <%# Compose row — comment input + "+ Schedule Swap" trigger. %>
        <div class="board-card-side-compose">
          <form class="board-card-comment-form"
                data-url="<%= resource_events_path(resource) %>">
            <input type="hidden" name="resource_event[kind]" value="comment">
            <textarea name="resource_event[body]" rows="2"
                      placeholder="Write a comment…"
                      class="form-control input-sm"></textarea>
            <div class="board-card-compose-actions">
              <button type="submit" class="btn btn-primary btn-xs">Comment</button>
              <button type="button" class="btn btn-default btn-xs board-card-schedule-swap-toggle">
                + Schedule Swap
              </button>
            </div>
          </form>

          <%# Hidden inline swap-schedule form. User enters FWD + the
              assignment length (days); JS derives LWD and injects it
              as a hidden field on submit so the server's existing
              fwd/lwd fields keep working unchanged. %>
          <form class="board-card-swap-form" style="display:none;"
                data-url="<%= resource_events_path(resource) %>">
            <input type="hidden" name="resource_event[kind]" value="scheduled_swap">
            <input type="hidden" name="resource_event[lwd]" value="">
            <div class="board-card-swap-row">
              <label>Leader</label>
              <input type="text" name="resource_event[leader]" class="form-control input-sm" required>
            </div>
            <div class="board-card-swap-row">
              <label>Phone</label>
              <input type="text" name="resource_event[phone]" class="form-control input-sm">
            </div>
            <div class="board-card-swap-row board-card-swap-row-dates">
              <div>
                <label>FWD</label>
                <input type="date" name="resource_event[fwd]"
                       class="form-control input-sm board-card-swap-fwd" required>
              </div>
              <div>
                <label>Assignment days</label>
                <input type="number" min="1" step="1"
                       class="form-control input-sm board-card-swap-length" required>
              </div>
            </div>
            <div class="board-card-swap-row board-card-swap-preview">
              <span class="muted">LWD will be:</span>
              <strong class="board-card-swap-lwd-preview">—</strong>
            </div>
            <div class="board-card-swap-row">
              <label>Notes</label>
              <textarea name="resource_event[body]" rows="1"
                        class="form-control input-sm"
                        placeholder="Optional"></textarea>
            </div>
            <div class="board-card-compose-actions">
              <button type="submit" class="btn btn-primary btn-xs">Schedule</button>
              <button type="button" class="btn btn-default btn-xs board-card-schedule-swap-cancel">Cancel</button>
            </div>
          </form>
        </div>

        <div class="board-card-activity-feed">
          <%= render partial: 'boards/activity_feed',
                     locals: { resource: resource, events: resource.resource_events.newest_first } %>
        </div>
      </aside>
    </div>

    <%# Full-width bottom cap — trash on the left, Demob on the right.
        Lives outside .board-card-details-body so it spans the modal
        edge to edge regardless of column heights. %>
    <div class="board-card-actions">
      <%= link_to resource_path(resource),
                  method: :delete,
                  data: { confirm: "Delete #{resource.full_order_number} #{resource.name}?" },
                  class: 'board-card-action board-card-action--delete',
                  title: 'Delete resource' do %>
        <i class="fa fa-trash" aria-hidden="true"></i>
      <% end %>
      <% if resource.demob %>
        <%= link_to 'DMB',
                    incident_resource_demob_path(@incident, resource, resource.demob),
                    class: 'demob-button btn tiny btn-dark' %>
      <% end %>
    </div>
  </div>
</li>
<% end %>
