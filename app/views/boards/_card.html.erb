<% if resource.spacer? %>
<li class="board-card board-card--spacer" data-resource-id="<%= resource.id %>" data-personnel="0">
  <div class="board-card-strip board-card-strip--spacer">
    <span class="board-card-spacer-label">Blank row</span>
    <button type="button" class="board-card-move-toggle" title="Move to another section">
      <i class="fa fa-arrows" aria-hidden="true"></i> Move
    </button>
    <button type="button" class="board-card-delete-spacer"
            data-url="<%= spacer_incident_board_path(@incident, resource) %>"
            title="Delete blank row">&times;</button>
    <div class="board-card-move-menu" style="display:none;">
      <ul class="board-card-move-menu-list"></ul>
    </div>
  </div>
</li>
<% else %>
<li class="board-card" data-resource-id="<%= resource.id %>" data-personnel="<%= resource.effective_personnel.to_i %>">
  <div class="board-card-strip" style="background: <%= resource_strip_color(resource) %>;">
    <span class="board-card-icon"><%= resource_icon_html(resource) %></span>
    <span class="board-card-agency"><%= resource.agency %></span>
    <button type="button" class="board-card-move-toggle" title="Move to another section">
      <i class="fa fa-arrows" aria-hidden="true"></i> Move
    </button>
    <div class="board-card-move-menu" style="display:none;">
      <ul class="board-card-move-menu-list"></ul>
    </div>
  </div>

  <div class="board-card-body">
    <div class="board-card-order"><%= resource.full_order_number %></div>
    <div class="board-card-name"><%= resource.name %></div>
    <div class="board-card-position"><%= resource.position %></div>

    <% lwd_class = lwd_status_class(resource) %>
    <% if lwd_class %>
      <span class="board-card-lwd <%= lwd_class %>">
        <i class="fa fa-clock-o" aria-hidden="true"></i>
        LWD <%= resource.last_work_day.strftime("%b %-d") %>
      </span>
    <% end %>
  </div>

  <%# No inline display:none — the modal visibility is driven by the
      `.board-card.is-expanded` toggle in boards.scss / boards.js. %>
  <div class="board-card-details">
    <%# Colored header strip matching the small card — same category
        color + icon + agency so the modal feels like a continuation
        of the card you double-clicked. %>
    <div class="board-card-details-header" style="background: <%= resource_strip_color(resource) %>;">
      <span class="board-card-icon"><%= resource_icon_html(resource) %></span>
      <span class="board-card-agency"><%= resource.agency %></span>
      <button type="button" class="board-card-details-close" aria-label="Close">&times;</button>
    </div>

    <dl class="board-card-fields">
      <dt>Order #</dt>
      <dd><%= best_in_place resource, :order_number, as: :input %></dd>

      <dt>Name</dt>
      <dd class="wide"><%= best_in_place resource, :name, as: :input %></dd>

      <dt>Position</dt>
      <dd><%= best_in_place resource, :position, as: :input %></dd>

      <dt>Leader</dt>
      <dd class="wide"><%= best_in_place resource, :leader, as: :input %></dd>

      <dt>Agency</dt>
      <dd><%= best_in_place resource, :agency, as: :input %></dd>

      <dt>Personnel</dt>
      <dd><%= best_in_place resource, :number_personnel, as: :input %></dd>

      <dt>Assignment days</dt>
      <dd><%= best_in_place resource, :assignment_length, as: :input %></dd>

      <dt>FWD</dt>
      <dd><%= best_in_place resource, :fwd, as: :input %></dd>

      <dt>Release</dt>
      <dd><%= best_in_place resource, :release_date, as: :input %></dd>

      <dt>Phone</dt>
      <dd><%= best_in_place resource, :phone, as: :input %></dd>

      <dt>Email</dt>
      <dd><%= best_in_place resource, :email, as: :input %></dd>

      <dt>Comment</dt>
      <dd class="full-width"><%= best_in_place resource, :comment, as: :textarea %></dd>
    </dl>

    <%# Modal footer actions — trash (left) + Demob (right). Shown only
        in the expanded modal because .board-card-actions lives inside
        .board-card-details, which is hidden until the card is expanded. %>
    <div class="board-card-actions">
      <%= link_to resource_path(resource),
                  method: :delete,
                  data: { confirm: "Delete #{resource.full_order_number} #{resource.name}?" },
                  class: 'board-card-action board-card-action--delete',
                  title: 'Delete resource' do %>
        <i class="fa fa-trash" aria-hidden="true"></i>
      <% end %>
      <% if resource.demob %>
        <%# Mirrors the DMB button on the ICS 211 — same classes, same
            nested path, so the look + click target behave identically
            across the two views. %>
        <%= link_to 'DMB',
                    incident_resource_demob_path(@incident, resource, resource.demob),
                    class: 'demob-button btn tiny btn-dark' %>
      <% end %>
    </div>
  </div>
</li>
<% end %>
