<% content_for :title, "Feature Requests" %>

<div class="container fr-page">
  <header class="fr-page-head">
    <h1>Feature Requests</h1>
    <p class="text-muted">Ideas users have suggested. Upvote what you'd like to see, or click through to comment.</p>
  </header>

  <% if @features.empty? && @completed_features.empty? %>
    <p class="text-muted"><em>No feature requests yet. Submit one via the bug icon (bottom right).</em></p>
  <% else %>
    <% if @features.any? %>
      <ul class="fr-list">
        <%= render partial: 'item', collection: @features, as: :feature %>
      </ul>
    <% else %>
      <p class="text-muted"><em>No open feature requests. See Completed below.</em></p>
    <% end %>

    <% if @completed_features.any? %>
      <section class="fr-completed-section">
        <h2 class="fr-section-head">Completed</h2>
        <ul class="fr-list fr-list--completed">
          <%= render partial: 'item', collection: @completed_features, as: :feature %>
        </ul>
      </section>
    <% end %>
  <% end %>
</div>
