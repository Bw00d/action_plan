<%# Self-contained (layout: false) so Bootstrap/app styles don't leak
    into the printed form. Layout mirrors the eISuite Commercial Air
    Travel Request. %>
<% r = @travel_request %>
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Commercial Air Travel Request</title>
  <style>
    @page { size: letter; margin: 0.5in; }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 11pt;
      color: #000;
    }
    .header { position: relative; text-align: center; margin-bottom: 22px; }
    .header .date { position: absolute; left: 0; top: 10px; }
    .header h1 { margin: 0; font-size: 16pt; }
    .header .incident { font-size: 10pt; font-weight: bold; margin-top: 4px; }

    .top { display: flex; justify-content: space-between; margin-bottom: 14px; }
    .ident { width: 58%; }
    .ident-row { display: flex; margin-bottom: 8px; }
    .ident-row .label { width: 160px; font-weight: bold; padding-top: 2px; }
    .ident-row .value { flex: 1; }
    .line { border-bottom: 1px solid #000; min-height: 20px; padding: 0 2px 2px; }
    .hint { font-size: 7.5pt; margin-top: 1px; }
    .type-box {
      width: 38%; align-self: flex-start;
      border: 1.5px solid #000; text-align: center;
      font-weight: bold; font-size: 13pt; padding: 4px;
    }

    .box { border: 1px solid #000; padding: 4px 6px 8px; }
    .travel-row { display: flex; align-items: flex-end; margin-bottom: 6px; }
    .travel-row .label { width: 280px; white-space: nowrap; }
    .blank { width: 130px; margin-right: 30px; text-align: center; }
    .blank .line { min-height: 18px; }
    .blank .hint { text-align: left; }
    .airport { flex: 1; text-align: center; }
    .airport .line { margin: 0 12px; }
    .airport-label { width: 110px; }

    h2 { font-size: 12pt; margin: 14px 0 6px; }
    table.questions { margin-left: 90px; border-collapse: collapse; font-size: 9.5pt; }
    table.questions td { padding: 4px 8px 4px 0; }
    table.questions td.q { width: 450px; }

    .instructions {
      border: 1px solid #000; min-height: 2.2in; padding: 4px;
      white-space: pre-wrap; font-size: 10.5pt;
    }
    .reassign .travel-row .label { width: 200px; }
    .reassign .quals { flex: 1; margin-right: 60px; }
  </style>
</head>
<body>
  <div class="header">
    <div class="date">Date:&nbsp;&nbsp; <%= r.created_at.strftime('%m/%d/%Y') %></div>
    <h1>COMMERCIAL AIR TRAVEL REQUEST</h1>
    <div class="incident">Incident: <%= @incident.name.to_s.upcase %> <%= @incident.number %></div>
  </div>

  <div class="top">
    <div class="ident">
      <div class="ident-row">
        <div class="label">Request #:</div>
        <div class="value"><div class="line"><%= r.request_number %></div></div>
      </div>
      <div class="ident-row">
        <div class="label">Resource Name:</div>
        <div class="value">
          <div class="line"><%= r.resource_name.to_s.upcase %></div>
          <div class="hint">(Must be name on picture ID)</div>
        </div>
      </div>
      <div class="ident-row">
        <div class="label">Unit ID:</div>
        <div class="value">
          <div class="line"><%= r.unit_id.to_s.upcase %></div>
          <div class="hint">State/Unit ID(EX:ID-BOD)</div>
        </div>
      </div>
      <div class="ident-row">
        <div class="label">Release To:</div>
        <div class="value">
          <div class="line"><%= r.release_to.upcase %></div>
          <div class="hint">Demob City/State</div>
        </div>
      </div>
    </div>
    <div class="type-box"><%= r.travel_type %></div>
  </div>

  <div class="box">
    <div class="travel-row">
      <div class="label">Date and Time Available to Leave ICP:</div>
      <div class="blank"><div class="line"><%= r.available_date&.strftime('%m/%d/%Y') %></div><div class="hint">Date</div></div>
      <div class="blank"><div class="line"><%= r.available_time %></div><div class="hint">Time</div></div>
    </div>
    <div class="travel-row">
      <div class="label">Travel Time from ICP to Airport:</div>
      <div class="blank"><div class="line"><%= r.travel_hours %></div><div class="hint">Hours</div></div>
      <div class="blank"><div class="line"><%= r.travel_minutes %></div><div class="hint">Minutes</div></div>
    </div>
    <div class="travel-row" style="margin-top: 10px;">
      <div class="airport-label">DEPART FROM:</div>
      <div class="airport"><div class="line"><%= r.depart_from %></div><div class="hint" style="text-align:center">Local Airport</div></div>
      <div class="airport-label">RETURN TO:</div>
      <div class="airport"><div class="line"><%= r.return_to %></div><div class="hint" style="text-align:center">Destination Airport</div></div>
    </div>
  </div>

  <h2>Travel Questions:</h2>
  <table class="questions">
    <% AirTravelRequest::TRAVEL_QUESTIONS.each_with_index do |(attr, question), i| %>
      <tr>
        <td><%= i + 1 %>.</td>
        <td class="q"><%= question %></td>
        <td><%= r.answer_for(attr) %></td>
      </tr>
    <% end %>
  </table>

  <h2 style="margin-top: 22px;">Special Instructions:</h2>
  <div class="instructions"><%= r.special_instructions %></div>

  <div class="reassign">
    <h2>Reassignment Information:</h2>
    <div class="box">
      <div class="travel-row">
        <div class="label">Last Date Available to Work:</div>
        <div class="blank"><div class="line"><%= r.last_date_available&.strftime('%m/%d/%Y') %></div></div>
      </div>
      <div class="travel-row">
        <div class="label">Reassignment Quals:</div>
        <div class="quals"><div class="line"><%= r.reassignment_quals %></div></div>
      </div>
    </div>
  </div>
</body>
</html>
