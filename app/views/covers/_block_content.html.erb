<%# Canvas block. x/y are the CENTER of the block as a percentage of
    the canvas dimensions. Convert to top-left for CSS positioning so
    jQuery UI's containment/pixel math stays intuitive. Font size is
    resolved to an absolute pixel value here — a preset ("h1".."h4")
    maps to a size, otherwise the string is parsed as a pixel number. %>
<% left_pct = block.x.to_f - block.width.to_f  / 2.0 %>
<% top_pct  = block.y.to_f - block.height.to_f / 2.0 %>
<%
  preset_px = { "h1" => 48, "h2" => 32, "h3" => 24, "h4" => 18 }
  font_px   = preset_px[block.font_size] || block.font_size.to_i
  font_px   = 24 if font_px <= 0
%>
<% is_notes = block.kind == "notes" %>
<% is_border = block.kind == 'border' %>
<div id="<%= dom_id(block) %>"
     class="cover-block <%= 'is-image' if block.image_block? %> <%= 'is-notes' if is_notes %> <%= 'is-border' if is_border %> <%= block.font_size %> weight-<%= block.font_weight %> style-<%= block.text_style %> align-<%= block.text_align %>"
     data-block-id="<%= block.id %>"
     data-font-size="<%= block.font_size %>"
     data-text-color="<%= block.text_color %>"
     data-border-width="<%= block.border_width %>"
     data-kind="<%= block.kind %>"
     style="left: <%= left_pct %>%; top: <%= top_pct %>%; width: <%= block.width %>%; height: <%= block.height %>%; <%= "font-size: #{font_px}px;" unless block.image_block? || is_notes || is_border %> <%= "font-family: #{block.font_family};" if block.font_family.present? && !block.image_block? && !is_notes && !is_border %> <%= "color: #{block.text_color};" if block.text_color.present? && !block.image_block? && !is_border %> <%= "border: #{block.border_width || 2}px solid #{block.text_color.presence || '#000'};" if is_border %>">
  <% if is_border %>
    <%# Border block — the interior is click-through so blocks sitting
        underneath can still be selected. These 4 overlay strips are the
        only parts of the block that catch pointer events: each strip
        covers an edge of the frame, so clicking the border edge selects
        / drags, and clicking the empty middle passes through to any
        block beneath. The resize handles jQuery UI adds live at the
        corners (on top of these strips) and still work. %>
    <div class="cover-border-edges">
      <div class="cover-border-edge top"></div>
      <div class="cover-border-edge right"></div>
      <div class="cover-border-edge bottom"></div>
      <div class="cover-border-edge left"></div>
    </div>
  <% elsif is_notes %>
    <div class="cover-notes">
      <div class="cover-notes-header">NOTES</div>
      <div class="cover-notes-lines">
        <% 12.times do %><div class="cover-notes-line"></div><% end %>
      </div>
    </div>
  <% elsif block.image_block? %>
    <% if block.main_image.attached? %>
      <%= image_tag block.main_image, class: "cover-block-image" %>
    <% else %>
      <div class="cover-block-image-placeholder">Image</div>
    <% end %>
  <% else %>
    <div class="cover-block-text"><%= block.content %></div>
  <% end %>
</div>
