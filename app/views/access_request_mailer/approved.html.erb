<p>Hi <%= @access_request.first_name %>,</p>

<p>Your request for access to Action Plan has been approved.</p>

<% if @accept_url %>
  <p>Click the button below to set your password and finish creating your account:</p>

  <p>
    <%= link_to "Set up my account", @accept_url, style: "display:inline-block;padding:10px 18px;background:#0052cc;color:#fff;text-decoration:none;border-radius:4px;" %>
  </p>

  <p>Or copy and paste this link into your browser:</p>
  <p><%= @accept_url %></p>
<% else %>
  <p>You already have an account, so you can <%= link_to "sign in", @sign_in_url %> with your existing password.</p>
<% end %>
