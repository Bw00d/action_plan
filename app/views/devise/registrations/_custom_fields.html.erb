<div class="form-group required">
  <%= f.label :first_name %>
  <%= f.text_field :first_name, class: "form-control" %>
</div>
<div class="form-group required">
  <%= f.label :last_name %>
  <%= f.text_field :last_name, class: "form-control" %>
</div>
<div class="form-group">
  <%= f.label :time_zone %>
  <%# US zones cover the field-tech population; if you need broader
      support, replace .us_zones with .all. Blank option lets the JS
      auto-detect flow fill it in on next page load. %>
  <%= f.time_zone_select :time_zone,
                         ActiveSupport::TimeZone.us_zones,
                         { include_blank: '(Auto-detect from browser)' },
                         class: 'form-control' %>
  <small class="text-muted">Controls how dates/times display for you (e.g. glide path, demob deadlines).</small>
</div>
