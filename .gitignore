# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

/db/*.sqlite3
/db/*.sqlite3-journal

/node_modules
/yarn-error.log

/storage/*
!/storage/.keep

.byebug_history

.elasticbeanstalk/*
!.elasticbeanstalk/*.cfg.yml
!.elasticbeanstalk/*.global.yml

# SimpleCov reports
coverage/

# Ignore master key for decrypting credentials and more.
/config/master.key

# Precompiled assets — Heroku's buildpack runs rake assets:precompile
# on every deploy, so these shouldn't be in the repo. Committing them
# bloats history and causes the buildpack to SKIP its own precompile
# (which would serve stale CSS/JS in prod if the local build was stale).
/public/assets
/public/packs
/public/packs-test
